     const rt_pad_tgt *t = rt_pad_target(&p, 0, 1);
     check(bad == 8, "eight bad controls lines are counted, a fallback on a step and four chords among them", "%d", bad);
-    /* Removing a chord moves the last into its place, so the recentre
-       default is first and the new one second. */
-    check(p.nchord == 2 && p.chord[0].mod == 4 && p.chord[0].btn == 5 && p.chord[0].target.kind == RT_PADT_RECENTRE &&
-              p.chord[1].mod == 3 && p.chord[1].btn == 10 && p.chord[1].target.kind == RT_PADT_KEY &&
-              p.chord[1].target.arg == SDL_SCANCODE_Z,
-          "chord.back+leftshoulder=none removes the view toggle, chord.north+dpup=z moves it, recentre stays", "%d chords, %d+%d",
-          p.nchord, p.chord[0].mod, p.chord[0].btn);
+    /* With no chord by default, removing one that is not there changes
+       nothing, and the line that adds one is the only chord. */
