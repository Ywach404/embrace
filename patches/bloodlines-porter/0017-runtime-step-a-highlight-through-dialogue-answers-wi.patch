     uint32_t msg, wp, lp;
 } rt_wmsg;
 
+/* The dialogue HUD's answer slots: four texts of 0x800 bytes, which is
+   the game's layout today. RT_DLG_KEYS is how many number keys its
+   Key_Event takes. Both are the game's limits, not the selector's: the
+   highlight steps through the count the game reports. */
+#define RT_DLG_TEXT 0x800
+#define RT_DLG_SLOTS 4
+#define RT_DLG_KEYS 4
+
+/* The dialogue answer highlight, drawn by the game itself as a "> "
+   written into the chosen slot's own text. saved is the slot's 0x800
+   bytes before the edit and written is what was put there, so a restore
+   happens only while the slot still holds exactly our edit. */
+typedef struct {
+    int lit, idx;
+    int32_t count;
+    uint32_t va;
+    uint32_t sum[RT_DLG_SLOTS], type[RT_DLG_SLOTS], flags[RT_DLG_SLOTS];
+    uint32_t pick_va, pick_bits;
+    uint64_t pick_ns;
+    int log_dirty;
+    uint64_t log_ns, reapply_log_ns;
+    uint32_t steps, confirms, resets, reapplies, held;
+    char saved[RT_DLG_TEXT], written[RT_DLG_TEXT];
+} rt_dialogue_sel;
+
 typedef struct {
     int32_t x, y;
     int32_t read_x, read_y;
@@ -60,6 +85,10 @@ typedef struct {
