@@ -1217,7 +1217,7 @@ static const struct {
     {SDL_GAMEPAD_BUTTON_START, -1, "Options", {WM_KEYDOWN, WM_KEYDOWN, WM_KEYDOWN}, {0x1B, 0x1B, 0x1B}},
     {SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, -1, "L1", {WM_MOUSEWHEEL, WM_MOUSEWHEEL, WM_MOUSEWHEEL}, {0, 0, 0}},
     {SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, -1, "R1", {WM_MOUSEWHEEL, WM_MOUSEWHEEL, WM_MOUSEWHEEL}, {0, 0, 0}},
-    {SDL_GAMEPAD_BUTTON_LEFT_STICK, -1, "L3", {WM_KEYDOWN, WM_KEYDOWN, WM_KEYDOWN}, {0x4C, 0x4C, 0x4C}},
