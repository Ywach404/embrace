diff --git a/runtime/handaim.c b/runtime/handaim.c
new file mode 100644
index 0000000..240c235
--- /dev/null
+++ b/runtime/handaim.c
@@ -0,0 +1,130 @@
+#include "recomp_types.h"
+#include "rt.h"
+#include "headlook.h"
+
+#include <TargetConditionals.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+/*
+ * Hand aim (visionOS, full view): a shot follows the aiming controller
+ * while the view keeps following the head. Head look writes the engine's
+ * view angles, which the view render copies and CreateMove copies into
+ * the user command; this turns only the command's angles, after the game
+ * has built the command, toward the hand. The command's angles are what
+ * the player fires along, and the engine's own, which the view is drawn
+ * from, are never written here, so they stay the head's. As in head look,
+ * the angles are absolute: the hand's offset from the head is added to
+ * this command alone, so nothing accumulates from one to the next.
+ *
+ * The seam is tools/m9/handaim.toml: CInput::CreateMove (client+0x103320)
+ * jumps at +0x1037a6, after SetViewAngles and ClientMode CreateMove, to a
+ * thunk that calls cell 57 with the command. Nothing after it writes the
+ * angles at cmd+0x14 before the command goes out.
+ */
+
+#define CMD_ANGLES 0x14u
+#define SITE_RVA 0x1037a6u
+#define CELL 57u
+/* The dword CreateMove reads at +0x103724 (0x102bd928 in the DLL): set,
+   the command takes the engine's angles and stores them; clear, it takes
+   the ones stored last, so the player's facing is held (Source's
+   g_iAlive). A held command keeps the game's angles. */
+#define LIVE_ANGLES_RVA 0x2bd928u
+
+static uint32_t s_aimed;
+
+uint32_t rt_hand_aim_commands(void) { return __atomic_load_n(&s_aimed, __ATOMIC_RELAXED); }
+
+#if TARGET_OS_VISION
+/* Off unless RT_HANDAIM=1: with nothing on screen showing where the hand
+   aims (the gun still follows the head), every shot of a headset run
+   (2026-11-21) went where the hand pointed and none where the player
+   looked. It comes on by default once the view model follows the hand. */
+static int wanted(void)
+{
+    static int env = -2;
+    if (env == -2) {
+        const char *v = getenv("RT_HANDAIM");
+        env = v && *v == '1';
+    }
+    return env;
+}
+
+/* ARKit's aim for a Sense controller points well above where the hand
+   points as it holds a gun: 18 to 34 degrees up with the player aiming
+   level or down at people (the same run). The aim is turned down about
+   the controller's own right axis by RT_HANDAIM_TILT degrees, 25 if not
+   set. */
+static void tilt_down(float m[16])
+{
+    static float deg = -1000.0f;
+    if (deg < -999.0f) {
+        const char *v = getenv("RT_HANDAIM_TILT");
+        deg = v && *v ? (float)atof(v) : 25.0f;
+        if (!(deg >= -60.0f && deg <= 60.0f)) deg = 25.0f;
+    }
+    float t = deg * (float)M_PI / 180.0f, c = cosf(t), s = sinf(t);
+    for (int r = 0; r < 3; r++) {
+        float y = m[4 + r], z = m[8 + r];
+        m[4 + r] = y * c - z * s;
+        m[8 + r] = z * c + y * s;
+    }
+}
+#endif
+
+static uint32_t hand_aim(const uint32_t *a)
+{
+#if TARGET_OS_VISION
+    uint32_t live = rt_hook_va("client", LIVE_ANGLES_RVA);
+    if (!a[0] || !live || !MEM32(live) || !wanted()) return 0;
+    float head_yaw, head_pitch, aim[16];
+    if (!rt_input_hand_aim_pose(&head_yaw, &head_pitch, aim)) return 0;
+    tilt_down(aim);
+    float cmd[3], out[3];
+    memcpy(cmd, rt_host(a[0] + CMD_ANGLES), sizeof cmd);
+    rt_headlook_hand_aim(cmd, head_yaw, head_pitch, aim, out);
+    memcpy(rt_host(a[0] + CMD_ANGLES), out, sizeof out);
+    uint32_t n = __atomic_add_fetch(&s_aimed, 1, __ATOMIC_RELAXED);
+    /* The first command and then one in 120, about two seconds: what the
+       game aimed, what the hand made of it, and the poses behind it, so a
+       run shows where shots go. */
+    if (n == 1 || n % 120 == 0) {
+        float hy, hp;
+        rt_headlook_yaw_pitch(aim, &hy, &hp);
+        rt_log("hand aim %u: game pitch %.1f yaw %.1f -> pitch %.1f yaw %.1f; head yaw %.1f pitch %.1f, hand yaw %.1f "
+               "pitch %.1f",
+               n, cmd[0], cmd[1], out[0], out[1], head_yaw, head_pitch, hy, hp);
+    }
+#else
+    (void)a;
+#endif
+    return 0;
+}
+
+static const rt_shim k_hand_aim = {"m9", "HandAim", 1, hand_aim, RT_SHIM_REAL};
+
+/* Bound on every platform: a lift with the row calls through the cell on
+   each CreateMove, and the shim does nothing off visionOS. A lift without
+   it keeps the stock store and nothing is bound. A site that matches
+   neither is logged and left alone, since the game plays the same
+   without hand aim. */
+void rt_hand_aim_init(void)
+{
+    static const uint8_t old[6] = {0x89, 0x87, 0xbc, 0x01, 0x00, 0x00};
+    uint32_t va = rt_hook_va("client", SITE_RVA);
+    if (!va) return;
+    if (rt_hook_claimed(va, sizeof old)) {
+        rt_log("hand aim: site 0x%08X owned by another hook", va);
+        return;
+    }
+    int st = rt_hook_site("hand_aim_cmd", va, old, sizeof old, -1, 0xE9, CELL, &k_hand_aim);
+    if (st == RT_HOOK_BAKED)
+        rt_log("hand aim: on (build), CreateMove at 0x%08X through cell %u%s", va, CELL,
+               TARGET_OS_VISION ? "" : "; it acts only on visionOS");
+    else if (st == RT_HOOK_ABSENT)
+        rt_log("hand aim: not in this build");
+    else
+        rt_log("hand aim: bytes at 0x%08X match neither the stock store nor the build's jump", va);
+}
diff --git a/runtime/headlook.c b/runtime/headlook.c
index 922734f..9063ce4 100644
--- a/runtime/headlook.c
+++ b/runtime/headlook.c
@@ -121,3 +121,38 @@ int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3])
     h->pose_pitch = -pitch;
     return 1;
 }
+
+/* As the host computes the head's angles (mtl_head_yaw_pitch in the
+   Metal backend), so a hand held where the head looks adds nothing.
+   Straight up or down leaves no heading in the forward axis, so it comes
+   from the up axis. */
+void rt_headlook_yaw_pitch(const float m[16], float *yaw_deg, float *pitch_deg)
+{
+    const double deg = 57.29577951308232;
+    double fx = -m[8], fy = -m[9], fz = -m[10];
+    if (fy > 1.0) fy = 1.0;
+    if (fy < -1.0) fy = -1.0;
+    double hx = fx, hz = fz;
+    if (hx * hx + hz * hz < 1e-6) {
+        double s = m[9] > 0 ? 1.0 : -1.0;
+        hx = s * m[4];
+        hz = s * m[6];
+    }
+    *yaw_deg = hx * hx + hz * hz > 0 ? (float)(atan2(-hx, -hz) * deg) : 0.0f;
+    *pitch_deg = (float)(asin(fy) * deg);
+}
+
+void rt_headlook_hand_aim(const float cmd[3], float head_yaw, float head_pitch, const float aim[16], float out[3])
+{
+    float yaw, pitch;
+    rt_headlook_yaw_pitch(aim, &yaw, &pitch);
+    /* Both yaws are positive left, as the game's is; ARKit's pitch is up
+       positive and the game's down positive, so the hand's rise above the
+       head lowers the command's pitch. */
+    float p = (float)(cmd[0] - (pitch - head_pitch));
+    if (p > RT_HEADLOOK_PITCH_DOWN) p = RT_HEADLOOK_PITCH_DOWN;
+    if (p < -RT_HEADLOOK_PITCH_UP) p = -RT_HEADLOOK_PITCH_UP;
+    out[0] = p;
+    out[1] = (float)rt_headlook_wrap(cmd[1] + rt_headlook_diff(head_yaw, yaw));
+    out[2] = cmd[2];
+}
diff --git a/runtime/headlook.h b/runtime/headlook.h
index 581a6c5..ce162b3 100644
--- a/runtime/headlook.h
+++ b/runtime/headlook.h
@@ -90,4 +90,16 @@ double rt_headlook_diff(double a, double b);
 /* Into -180..180. */
 double rt_headlook_wrap(double a);
 
+/* Hand aim: the command's angles turned from where the head looks to
+   where the aiming hand points, so a shot follows the hand while the view
+   stays the head's. cmd (pitch, yaw, roll) stands for the head at
+   head_yaw and head_pitch (ARKit); aim is the hand's column-major
+   transform from its aim location to ARKit's origin, forward -Z. out
+   gets the command's angles with the hand's offset from the head added,
+   the pitch clamped to the game's limits and the roll kept. */
+void rt_headlook_hand_aim(const float cmd[3], float head_yaw, float head_pitch, const float aim[16], float out[3]);
+/* A transform's heading and elevation, the head's convention: yaw
+   positive turning left from -Z, pitch positive up, degrees. */
+void rt_headlook_yaw_pitch(const float m[16], float *yaw_deg, float *pitch_deg);
+
 #endif
diff --git a/runtime/host.h b/runtime/host.h
index d360f19..2bb90d0 100644
