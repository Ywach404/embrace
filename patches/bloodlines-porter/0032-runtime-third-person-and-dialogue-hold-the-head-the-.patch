 /* Whether a frame is play for head look and full view. A dialogue counts
    in full view: dropping to the plane took the world away for every line
-   spoken (2026-11-20 headset run), and head look staying on there keeps
-   the NPC still while the head turns, the game's turn toward the speaker
-   kept as the body's. On the theater screen it pauses head look as
-   before, so the game's close up holds. */
+   spoken (2026-11-20 headset run). Head look holds there
+   (rt_input_head_mode), so the close up is the game's and the world
+   stays still in the room. On the theater screen it pauses head look as
+   before. */
 int rt_input_view_play(int focus, int pad_mode, int head_allowed, int full_view)
 {
     if (!focus || !head_allowed) return 0;
@@ -1416,11 +1420,12 @@ void rt_host_hand_pose(int side, int state, const float grip[16], const float ai
 int rt_host_aim_hand(void) { return __atomic_load_n(&s_padv.pad.aim_left, __ATOMIC_RELAXED) ? 1 : 0; }
 
 /* Whether the pad's right stick should turn the body this poll: the host
-   gives a pose and the game's angles are there to write. */
+   gives a pose, the game's angles are there to write, and the head drives
+   the view. Held (third person), the stick looks as it does flat. */
 static int head_wanted(void)
 {
     return __atomic_load_n(&s_head_on, __ATOMIC_ACQUIRE) && rt_hook_va("engine", VIEW_ANGLES_RVA) != 0 &&
-           rt_input_head_mode(&S) != RT_HEAD_NONE;
+           rt_input_head_mode(&S) == RT_HEAD_FULL;
 }
 
 /* Once a game frame, at the first pump after a Present: a pump can also
@@ -1448,33 +1453,34 @@ static void head_pump(void)
     }
     s_head_present = presents;
     /* Head look off by hand pauses it like a menu does, so the frame
-       leaves full view for the theater plane. Third person keeps the head
-       for pitch and stays in full view, as a dialogue does when full view
