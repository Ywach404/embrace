+/* The window entries the guest's user32 calls reach. Each is one hop on
+   visionOS, so creating a window, with its configuration, placement, input
+   and gamepad start, crosses to the main thread once. */
+#if TARGET_OS_VISION
+typedef struct {
+    rt_win *w;
+    int a, b;
+} win_args;
+
+static void free_hop(void *p) { win_free(((win_args *)p)->w); }
+
+static void sdl_hop(void *p)
+{
+    win_sdl(((win_args *)p)->w);
+    /* With its event pump off, SDL watches the app's lifecycle (resign
+       active, background, terminate) only while a window exists, and
+       decides that only when the pump setting is made. Making it again
+       now that one does starts the watch. */
+    SDL_SetiOSEventPump(false);
+}
+
+static void resize_hop(void *p)
+{
+    win_args *x = p;
+    win_resize(x->w, x->a, x->b);
+}
+
+static void show_hop(void *p)
+{
+    win_args *x = p;
+    win_show(x->w, x->a);
+}
+#endif
+
+void rt_win_free(rt_win *w)
+{
+#if TARGET_OS_VISION
+    win_args x = {w, 0, 0};
+    rt_main_hop(free_hop, &x);
+#else
+    win_free(w);
+#endif
+}
+
+void rt_win_sdl(rt_win *w)
+{
+    if (!s_sdl) return;
+#if TARGET_OS_VISION
+    win_args x = {w, 0, 0};
+    rt_main_hop(sdl_hop, &x);
+#else
+    win_sdl(w);
+#endif
+}
+
+void rt_win_resize(rt_win *w, int cw, int ch)
+{
+#if TARGET_OS_VISION
+    win_args x = {w, cw, ch};
+    rt_main_hop(resize_hop, &x);
+#else
+    win_resize(w, cw, ch);
+#endif
+}
+
+void rt_win_show(rt_win *w, int show)
+{
+#if TARGET_OS_VISION
+    win_args x = {w, show, 0};
+    rt_main_hop(show_hop, &x);
+#else
+    win_show(w, show);
+#endif
+}
