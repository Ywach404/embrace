+/* The engine's view angles: one QAngle (pitch, yaw, roll, degrees) that
+   IVEngineClient's GetViewAngles and SetViewAngles (VEngineClient006,
+   vtable +0xc4 and +0xc8) copy out of and into, with no other state and
+   no use of this, so a write here is exactly SetViewAngles. The client's
+   CreateMove reads it, adds mouse, clamps pitch to cl_pitchup and
+   cl_pitchdown (89 each) and writes it back; the view render copies it
+   each frame. An absolute write cannot drift, where mouse counts would
+   pass through sensitivity, m_yaw and a truncating scale. */
+#define VIEW_ANGLES_RVA 0x314868u
+
+int rt_input_head_apply(rt_headlook *h, rt_headlook_in *in, uint32_t va)
+{
+    in->have_angles = va != 0;
+    if (va) memcpy(in->game, rt_host(va), sizeof in->game);
+    float out[3];
+    if (!rt_headlook_step(h, in, out)) return 0;
+    memcpy(rt_host(va), out, sizeof out);
+    return 1;
+}
+
+#if TARGET_OS_VISION
+void metal_d3d9_immersive_view_pose(int valid, float yaw_deg, float pitch_deg);
+
+/* The host's latest head pose: the two angles' float bits in one word so
+   a pump never pairs one pose's yaw with another's pitch, and whether
+   there is one. Recentres from the host are counted. */
+static int s_head_on;
+static uint64_t s_head_bits;
+static uint32_t s_head_host_recentres;
+static rt_headlook s_head;
+static int s_head_init;
+static uint32_t s_head_present, s_head_seen_rc;
+
+void rt_host_head_pose(int on, float yaw_deg, float pitch_deg)
+{
+    uint32_t y, p;
+    memcpy(&y, &yaw_deg, 4);
+    memcpy(&p, &pitch_deg, 4);
+    __atomic_store_n(&s_head_bits, (uint64_t)y << 32 | p, __ATOMIC_RELAXED);
+    __atomic_store_n(&s_head_on, on != 0, __ATOMIC_RELEASE);
+}
+
+void rt_host_head_recentre(void) { __atomic_fetch_add(&s_head_host_recentres, 1, __ATOMIC_ACQ_REL); }
+
+/* Whether the pad's right stick should turn the body this poll: the host
+   gives a pose and the game's angles are there to write. */
+static int head_wanted(void)
+{
+    return __atomic_load_n(&s_head_on, __ATOMIC_ACQUIRE) && rt_hook_va("engine", VIEW_ANGLES_RVA) != 0;
+}
+
+/* Once a game frame, at the first pump after a Present: a pump can also
+   run between the game's CreateMove and its Present, and angles or a
+   pose changed there would not be the ones the frame is drawn with. The
+   pose given to the backend is the one the next Present latches. */
+static void head_pump(void)
+{
+    if (!s_head_init) {
+        rt_headlook_init(&s_head);
+        s_head_init = 1;
+    }
+    rt_headlook_in in;
+    memset(&in, 0, sizeof in);
+    in.host_on = __atomic_load_n(&s_head_on, __ATOMIC_ACQUIRE);
+    uint64_t b = __atomic_load_n(&s_head_bits, __ATOMIC_RELAXED);
+    uint32_t y = (uint32_t)(b >> 32), p = (uint32_t)b;
+    memcpy(&in.head_yaw, &y, 4);
+    memcpy(&in.head_pitch, &p, 4);
+    pthread_mutex_lock(&s_mu);
+    uint32_t presents = L.presents;
+    if (presents == s_head_present) {
+        pthread_mutex_unlock(&s_mu);
+        return;
+    }
+    s_head_present = presents;
+    in.play = S.focus && rt_input_pad_mode(&S) == RT_PAD_PLAY;
+    in.turn = rt_pad_take_turn(&s_padv.pad);
+    uint32_t rc = S.head_recentres + __atomic_load_n(&s_head_host_recentres, __ATOMIC_ACQUIRE);
+    in.recentre = rc != s_head_seen_rc;
+    s_head_seen_rc = rc;
+    pthread_mutex_unlock(&s_mu);
+    int was_on = s_head.on, was_playing = s_head.playing;
+    uint32_t was_rc = s_head.recentres, was_abs = s_head.absorbed;
+    rt_input_head_apply(&s_head, &in, rt_hook_va("engine", VIEW_ANGLES_RVA));
+    metal_d3d9_immersive_view_pose(s_head.pose_valid, s_head.pose_yaw, s_head.pose_pitch);
+    if (s_head.on != was_on) rt_log("head look %s", s_head.on ? "on: the head drives the view" : "off: the game's camera");
+    else if (s_head.on && s_head.playing != was_playing)
+        rt_log("head look %s", s_head.playing ? "resumed" : "paused (menu, dialogue or sheet)");
+    if (s_head.recentres != was_rc) rt_log("head look recentred (%u this run)", s_head.recentres);
+    if (s_head.absorbed != was_abs && s_head.absorbed <= 32)
+        rt_log("head look: the game turned the view itself, kept (%u this run)%s", s_head.absorbed,
+               s_head.absorbed == 32 ? "; no more of these" : "");
+}
+#endif
+
 static void pad_pump(void)
 {
     rt_present_rects r;
@@ -1222,6 +1323,9 @@ static void pad_pump(void)
     rt_wmsg m[128];
     rt_input_geometry(&r, &d);
     pthread_mutex_lock(&s_mu);
+#if TARGET_OS_VISION
+    s_padv.pad.head = head_wanted();
+#endif
     int n = rt_input_pad_pump(&S, &s_padv, S.focus, rt_now_ns(), &r, d, m, 128);
     pthread_mutex_unlock(&s_mu);
     post_all(m, n, 128);
@@ -1233,6 +1337,9 @@ void rt_input_pump_end(void)
     if (!s_win) return;
     dialogue_update();
     if (s_pad_started) pad_pump();
+#if TARGET_OS_VISION
+    head_pump();
+#endif
     rt_wmsg m[1];
     int warp = 0, shape, rel_changed;
     int32_t wx = 0, wy = 0, ox = 0, oy = 0;
@@ -1428,6 +1535,8 @@ void rt_input_report(void)
         uint32_t hm = H.moves, hb = H.buttons, hw = H.wheels;
         pthread_mutex_unlock(&s_mu);
         rt_log("input host moves %u buttons %u wheels %u claim %s", hm, hb, hw, host_claimed() ? "on" : "off");
+        rt_log("input head look starts %u writes %u pauses %u recentres %u kept game turns %u pitch clamps %u", s_head.starts,
+               s_head.writes, s_head.pauses, s_head.recentres, s_head.absorbed, s_head.clamps);
     }
 #endif
     if (!armed) return;
