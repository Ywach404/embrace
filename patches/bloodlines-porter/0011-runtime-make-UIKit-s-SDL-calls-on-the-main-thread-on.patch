--- /dev/null
+++ b/runtime/main_hop.h
@@ -0,0 +1,34 @@
+#ifndef RT_MAIN_HOP_H
+#define RT_MAIN_HOP_H
+
+/*
+ * visionOS only. UIKit and FrontBoard assert that windows, scenes and views
+ * are touched on the process main thread, and on visionOS that thread runs
+ * the host app's SwiftUI run loop while the runtime runs on host_thread
+ * (runtime/host.h). So every SDL call that reaches UIKit is made on the
+ * main thread through rt_main_hop, and SDL's video and events are
+ * initialised there, which makes the real main thread SDL's main thread.
+ *
+ * rt_main_hop runs fn(ctx) on the main thread and returns when it has run.
+ * It is a dispatch_sync to the main queue, not SDL_RunOnMainThread: SDL
+ * only drains that queue from an SDL_PumpEvents on its main thread, which
+ * nothing on the SwiftUI side calls. Waiting is safe because the main
+ * thread never waits for the runtime's threads: the host's done callback
+ * goes back to it asynchronously, and the runtime has no SDL_Quit and ends
+ * the process with _exit. Called on the main thread, fn runs in place, so
+ * hops nest (a pump hop that runs an input script that minimises).
+ *
+ * Every hop also refreshes a cached pixel size of the game's main window,
+ * which rt_window_pixels answers from off the main thread, because SDL
+ * reads it from the UIView's bounds and the present path asks every frame.
+ *
+ * rt_window_main_ready declares the main thread SDL's main thread. The
+ * host calls it, through rt_host_start, before the runtime's thread exists,
+ * so no SDL subsystem the runtime's thread starts (audio, from the dsound
+ * shim) can make that thread SDL's main thread instead.
+ */
+void rt_main_hop(void (*fn)(void *ctx), void *ctx);
+int rt_window_pixels(void *sdl_window, int *w, int *h);
+void rt_window_main_ready(void);
+
+#endif
