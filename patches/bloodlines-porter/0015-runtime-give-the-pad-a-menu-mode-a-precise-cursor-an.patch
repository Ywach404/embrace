+static void pad_controls(void)
+{
+    const char *tmp = getenv("TMPDIR");
+    char dir[512], path[600];
+    snprintf(dir, sizeof dir, "%s/rt-pad-selftest-XXXXXX", tmp && *tmp ? tmp : "/tmp");
+    if (!mkdtemp(dir)) {
+        check(0, "controls scratch folder", "%s", dir);
+        return;
+    }
+    snprintf(path, sizeof path, "%s/controls.txt", dir);
+    FILE *f = fopen(path, "w");
+    if (!f) {
+        check(0, "controls file", "%s", path);
+        return;
+    }
+    fputs("# test\nmenu.south=space\nmenu.east=play\nwest=r\nmenu.dpup=up\ntouchpad=none\ncursor_speed=800\ncursor_power=2\n"
+          "menu.bogus=x\nmenu.north=notakey\n",
+          f);
+    fclose(f);
+    rt_pad p;
+    int bad = rt_pad_load(&p, dir);
+    unlink(path);
+    rmdir(dir);
+    const rt_pad_tgt *t = rt_pad_target(&p, 0, 1);
+    check(bad == 2, "two bad controls lines are counted", "%d", bad);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_SPACE, "menu.south remaps Cross in menus only", "%d %d", t->kind, t->arg);
+    t = rt_pad_target(&p, 0, 0);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_SPACE, "play south keeps its default", "%d", t->arg);
+    t = rt_pad_target(&p, 1, 1);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_E, "menu.east=play hands Circle back to its play key", "%d", t->arg);
+    t = rt_pad_target(&p, 2, 0);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_R, "west remaps Square in play", "%d", t->arg);
+    t = rt_pad_target(&p, 2, 1);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_I, "a play remap leaves Square's menu key", "%d", t->arg);
+    t = rt_pad_target(&p, 10, 1);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_UP, "menu.dpup can send an arrow", "%d", t->arg);
+    t = rt_pad_target(&p, RT_PAD_TOUCHPAD, 0);
+    check(t->kind == RT_PADT_NONE, "none unbinds a button", "%d", t->kind);
+    t = rt_pad_target(&p, 3, 1);
+    check(t->kind == RT_PADT_KEY && t->arg == SDL_SCANCODE_F, "a bad menu target falls through to play", "%d", t->arg);
+    check(p.cursor_speed == 800 && p.cursor_power == 2, "controls.txt sets the cursor curve", "%d %f", p.cursor_speed, p.cursor_power);
+}
