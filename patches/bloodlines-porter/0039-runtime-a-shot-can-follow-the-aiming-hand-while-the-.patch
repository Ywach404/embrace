diff --git a/runtime/input.c b/runtime/input.c
index 637ce40..aea35e7 100644
--- a/runtime/input.c
+++ b/runtime/input.c
@@ -1406,7 +1406,8 @@ void rt_host_head_recentre(void) { __atomic_fetch_add(&s_head_host_recentres, 1,
 
 /* The host's latest tracked hand poses, one slot per side. A sequence
    word around each write lets a reader that comes later take a whole
-   pose: odd while a write is under way. Nothing reads them yet. */
+   pose: odd while a write is under way. Hand aim reads the aiming one
+   (rt_input_hand_aim_pose). */
 typedef struct {
     uint32_t seq;
     int state;
@@ -1434,6 +1435,39 @@ void rt_host_hand_pose(int side, int state, const float grip[16], const float ai
 
 int rt_host_aim_hand(void) { return __atomic_load_n(&s_padv.pad.aim_left, __ATOMIC_RELAXED) ? 1 : 0; }
 
+/* Read at the game's CreateMove (handaim.c), on the game thread. The pump
+   that steps s_head runs on the main thread inside a hop the game thread
+   waits on, so its fields are settled here. The pose is the one the
+   angles CreateMove copied into the command were written for; a hold, a
+   pause or no head pose leaves the command the game's. The hand's slot is
+   written from the compositor's thread, so it is copied under its
+   sequence word and a write caught under way is tried again. */
+int rt_input_hand_aim_pose(float *head_yaw, float *head_pitch, float aim[16])
+{
+    if (!s_head_init || !s_head.on || !s_head.playing || s_head.holding || !s_head.pose_valid) return 0;
+    pthread_mutex_lock(&s_mu);
+    int mode = rt_input_head_mode(&S);
+    pthread_mutex_unlock(&s_mu);
+    if (mode != RT_HEAD_FULL) return 0;
+    /* rt_host_aim_hand is 1 for the left, and the left is slot 0. */
+    const rt_hand_slot *h = &s_hands[rt_host_aim_hand() ? 0 : 1];
+    for (int tries = 0; tries < 4; tries++) {
+        uint32_t a = __atomic_load_n(&h->seq, __ATOMIC_ACQUIRE);
+        if (a & 1) continue;
+        int state = h->state;
+        float m[16];
+        memcpy(m, h->aim, sizeof m);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&h->seq, __ATOMIC_RELAXED) != a) continue;
+        if (state < 1) return 0;
+        *head_yaw = s_head.pose_yaw;
+        *head_pitch = s_head.pose_pitch;
+        memcpy(aim, m, sizeof m);
+        return 1;
+    }
+    return 0;
+}
+
