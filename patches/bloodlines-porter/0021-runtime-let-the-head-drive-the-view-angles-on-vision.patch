  */
 void *rt_host_game_window(void);
 
+/*
+ * Head look (runtime/headlook.h): the game's view angles follow the
+ * head. rt_host_head_pose(1, yaw, pitch) gives the head's yaw and pitch
+ * in degrees in ARKit's world (yaw positive turning left from -Z, pitch
+ * positive up), as often as the host likes; the runtime takes the latest
+ * once a game frame, at the first pump after each Present, and writes the
+ * view angles from it before the game builds its next frame.
+ * rt_host_head_pose(0, ...) hands the camera back to the game (mono, or
+ * the head not tracked), and the view stays where it was. While the head
+ * drives the view, the right stick turns the body instead of looking, a
+ * menu, dialogue or the character sheet pauses it, and the head pose
+ * each frame was drawn for goes to the backend with that frame
+ * (metal_d3d9_immersive_view_pose) for the compositor's late rotation.
+ * rt_host_head_recentre asks for what Create plus Options does: the
+ * body takes the view's heading and the head's facing becomes straight
+ * ahead, with no turn of the view. Any thread; neither waits.
+ */
+void rt_host_head_pose(int on, float yaw_deg, float pitch_deg);
+void rt_host_head_recentre(void);
+
 /*
  * Writes one line from the host to the runtime's log, after "host: ", so
  * what the host sees (GameController's own view of the controllers, say)
