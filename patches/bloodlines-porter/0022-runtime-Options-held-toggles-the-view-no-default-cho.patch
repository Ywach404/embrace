+/* A chord as controls.txt's chord.mod+btn=target line makes it: none is
+   on by default any more. */
+static void add_chord(rt_pad *p, int mod, int btn, int kind, int arg)
+{
+    p->chord[p->nchord++] = (rt_pad_chord){mod, btn, {kind, arg, RT_PADT_NONE, 0}};
+}
+
 /* Create plus L1 in play is the game's togglecamera bind (z): once per
    press, L1's own wheel step and Create's character sheet both held back;
    Create alone still opens the sheet, on release; L1 alone still steps;
@@ -2158,8 +2182,9 @@ static void pad_chords(void)
     rt_pad_dev_init(&d, NULL);
     SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
     padpump(&s, &d, 10);
-    check(d.pad.mode == RT_PAD_PLAY && d.pad.nchord == 2, "the view toggle and recentre chords are there by default", "mode %d chords %d",
-          d.pad.mode, d.pad.nchord);
+    check(d.pad.mode == RT_PAD_PLAY && d.pad.nchord == 0, "no chord is there by default", "mode %d chords %d", d.pad.mode,
+          d.pad.nchord);
+    add_chord(&d.pad, 4, 6, RT_PADT_KEY, SDL_SCANCODE_Z);
     for (int round = 0; round < 2; round++) {
         char name[96];
         s_n = 0;
@@ -2239,6 +2264,151 @@ static void pad_chords(void)
     padpump(&s, &d, 10);
 }
 
+/* A punch with the sticks still is a plain click: no move rides with
+   it. On the headset a swing needs something in reach, which is why
+   punches at a distant view seemed lost. */
+static void pad_punch(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
+    padpump(&s, &d, 10);
+    int ok = 1, x0 = s.x, y0 = s.y;
+    for (int i = 0; i < 5; i++) {
+        s_n = 0;
+        rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 32767);
+        padpump(&s, &d, 10);
+        ok &= s_n == 1 && s_m[0].msg == WM_LBUTTONDOWN && s_m[0].wp == MK_LBUTTON;
+        s_n = 0;
+        rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+        padpump(&s, &d, 10);
+        ok &= s_n == 1 && s_m[0].msg == WM_LBUTTONUP;
+    }
+    check(s.relative && ok && s.x == x0 && s.y == y0,
+          "five trigger pulls in play with the sticks still: each a plain press and release, no move", "relative %d x %d y %d %s", s.relative,
+          s.x, s.y, dump());
+    rt_pad_test_detach(id);
+}
+
+/* Options in play: a tap is the game's menu on the release, a hold past
+   RT_PAD_HOLD_NS is one z (togglecamera) and no menu, however long it is
+   held. On the Sense pair, whose Options is on the right half, and on a
+   DualSense. hold.start=none in controls.txt gives Options its press
+   back. */
+static void pad_hold_one(const char *pad)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    char name[160];
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach(pad);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 1);
+    padpump(&s, &d, 10);
+    snprintf(name, sizeof name, "%s: Options pressed sends nothing yet", pad);
+    check(s_n == 0, name, "%s", dump());
+    padpump(&s, &d, 100);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 0);
+    padpump(&s, &d, 10);
+    snprintf(name, sizeof name, "%s: an Options tap is Escape on the release", pad);
+    check(s_n >= 2 && s_m[0].msg == WM_KEYDOWN && s_m[0].wp == 0x1B && s_m[s_n - 1].msg == WM_KEYUP && s_m[s_n - 1].wp == 0x1B, name, "%s",
+          dump());
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 1);
+    padpump(&s, &d, 10);
+    padpump(&s, &d, 600);
+    int toggled = s_n == 2 && s_m[0].msg == WM_KEYDOWN && s_m[0].wp == 0x5A && s_m[1].msg == WM_KEYUP && s_m[1].wp == 0x5A;
+    s_n = 0;
+    for (int i = 0; i < 20; i++) padpump(&s, &d, 100);
+    int quiet = s_n == 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 0);
+    padpump(&s, &d, 10);
+    snprintf(name, sizeof name, "%s: Options held is one z, held on it sends no more, and its release no menu", pad);
+    check(toggled && quiet && s_n == 0 && d.pad.holds_fired == 1, name, "toggled %d quiet %d holds %u %s", toggled, quiet,
+          d.pad.holds_fired, dump());
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
+
+static void pad_hold(void)
+{
+    pad_hold_one("PlayStation VR2 Sense Controllers (L/R)");
+    pad_hold_one("DualSense Wireless Controller");
+    const char *tmp = getenv("TMPDIR");
+    char dir[512], path[600];
+    snprintf(dir, sizeof dir, "%s/rt-pad-hold-XXXXXX", tmp && *tmp ? tmp : "/tmp");
+    if (!mkdtemp(dir)) {
+        check(0, "hold scratch folder", "%s", dir);
+        return;
+    }
+    snprintf(path, sizeof path, "%s/controls.txt", dir);
+    FILE *f = fopen(path, "w");
+    if (!f) {
+        check(0, "hold controls file", "%s", path);
+        return;
+    }
+    fputs("hold.start=none\nhold.south=e\nhold.north=answerup\nhold.bogus=z\n", f);
+    fclose(f);
+    rt_pad p;
+    int bad = rt_pad_load(&p, dir);
+    unlink(path);
+    rmdir(dir);
+    check(bad == 2 && p.hold[5].kind == RT_PADT_NONE && p.hold[0].kind == RT_PADT_KEY && p.hold[0].arg == SDL_SCANCODE_E &&
+              p.hold[3].kind == RT_PADT_NONE,
+          "controls.txt hold.btn=target sets or removes a hold, and refuses an action or an unknown button", "bad %d start %d south %d north %d",
+          bad, p.hold[5].kind, p.hold[0].kind, p.hold[3].kind);
+}
+
+/* The HUD's history view, flipped by every mouse1 key event, left on
+   after a punch in play: the pump turns it off while no dialogue is
+   active, and leaves a dialogue's own alone. */
+static void pad_history(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
+    fake_open(3);
+    fake8(DIALOGUE_ACTIVE_OFF, 0);
+    fake8(DIALOGUE_HISTORY_OFF, 1);
+    s.dialogue_va = FAKE_VA;
+    padpump(&s, &d, 10);
+    check(*(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF) == 0 && *(uint8_t *)rt_host(FAKE_VA + 0x190u) == 1 &&
+              s.sel.history_cleared == 1,
+          "a history view on with no dialogue is turned off", "history %d cleared %u", *(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF),
+          s.sel.history_cleared);
+    fake8(DIALOGUE_ACTIVE_OFF, 1);
+    s.dialogue = 1;
+    fake8(DIALOGUE_HISTORY_OFF, 1);
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(*(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF) == 1 && s.sel.history_cleared == 1,
+          "a dialogue's own history view is left until a step", "history %d", *(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF));
+    padpump(&s, &d, 10);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTY, 32767);
+    padpump(&s, &d, 10);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTY, 0);
+    padpump(&s, &d, 10);
+    check(marked() == 0 && *(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF) == 0, "a stick step closes it and marks the first answer",
+          "slot %d history %d", marked(), *(uint8_t *)rt_host(FAKE_VA + DIALOGUE_HISTORY_OFF));
+    tap(&s, &d, id, PM_CIRCLE);
+    s.dialogue = 0;
+    s.dialogue_va = 0;
+    padpump(&s, &d, 10);
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
+
 static void pad_controls(void)
 {
     const char *tmp = getenv("TMPDIR");
@@ -2267,13 +2437,12 @@ static void pad_controls(void)
