+/* Head look's composition (headlook.c), as the pump drives it once a
+   game frame: the game stores what is written as floats, as its own
+   QAngle does. */
+static int hl_step(rt_headlook *h, rt_headlook_in *in, float game[3])
+{
+    memcpy(in->game, game, sizeof in->game);
+    float out[3];
+    int w = rt_headlook_step(h, in, out);
+    if (w) memcpy(game, out, sizeof out);
+    in->turn = 0;
+    in->recentre = 0;
+    return w;
+}
+
+static int near_deg(double a, double b, double eps) { return fabs(rt_headlook_diff(a, b)) <= eps; }
+
+static void head_look(void)
+{
+    rt_headlook h;
+    rt_headlook_init(&h);
+    rt_headlook_in in = {.host_on = 1, .head_yaw = 20, .head_pitch = 0, .play = 1, .have_angles = 1};
+    float game[3] = {12, 100, 0};
+
+    int w = hl_step(&h, &in, game);
+    check(w && game[1] == 100 && game[0] == 0 && h.pose_valid && h.pose_yaw == 20,
+          "head look starts where the game looks, at the head's pitch", "w %d pitch %.3f yaw %.3f pose %d %.3f", w, game[0], game[1],
+          h.pose_valid, h.pose_yaw);
+    in.head_yaw = 50;
+    hl_step(&h, &in, game);
+    check(game[1] == 130, "the view's yaw is the body plus the head's turn", "yaw %.4f", game[1]);
+    in.head_yaw = -170;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], -90, 1e-4), "a head turn across -180 wraps, not jumps", "yaw %.4f", game[1]);
+    in.head_yaw = 50;
+    in.head_pitch = 30;
+    hl_step(&h, &in, game);
+    check(game[0] == -30 && h.pose_pitch == 30, "looking up is negative game pitch", "pitch %.3f pose %.3f", game[0], h.pose_pitch);
+    in.head_pitch = -89.9f;
+    hl_step(&h, &in, game);
+    check(game[0] == RT_HEADLOOK_PITCH_DOWN && h.clamps == 1 && h.pose_pitch == -RT_HEADLOOK_PITCH_DOWN,
+          "pitch is clamped to the game's limit, and the frame's pose says the limit", "pitch %.3f clamps %u pose %.3f", game[0], h.clamps,
+          h.pose_pitch);
+    in.head_pitch = 89.9f;
+    hl_step(&h, &in, game);
+    check(game[0] == -RT_HEADLOOK_PITCH_UP, "and up", "pitch %.3f", game[0]);
+    in.head_pitch = 0;
+
+    in.turn = -45;
+    hl_step(&h, &in, game);
+    check(game[1] == 85, "the stick's turn adds to the body", "yaw %.4f", game[1]);
+
+    /* Recentre: the body takes the view's heading, the head's facing now
+       is straight ahead, and nothing moves. */
+    in.head_yaw = 80;
+    hl_step(&h, &in, game);
+    float before = game[1];
+    in.recentre = 1;
+    hl_step(&h, &in, game);
+    check(game[1] == before && h.recentres == 1 && near_deg(h.body, before, 1e-4) && h.ref == 80,
+          "recentre moves the body to the view and the view nowhere", "yaw %.4f before %.4f body %.4f ref %.3f", game[1], before, h.body,
+          h.ref);
+    in.head_yaw = 90;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], before + 10, 1e-4), "after it the head turns the view from there", "yaw %.4f", game[1]);
+
+    /* A menu pauses it: nothing written, the pose kept as it was. */
+    float kept_pose = h.pose_yaw, at_pause = game[1];
+    in.play = 0;
+    in.head_yaw = 130;
+    w = hl_step(&h, &in, game);
+    check(!w && game[1] == at_pause && h.pose_valid && h.pose_yaw == kept_pose && h.pauses == 1,
+          "a menu pauses head turning: the view stays and the frame keeps the last pose", "w %d yaw %.3f pose %.3f pauses %u", w, game[1],
+          h.pose_yaw, h.pauses);
+    for (int i = 0; i < 20; i++) hl_step(&h, &in, game);
+    in.play = 1;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], at_pause + 40, 1e-4) && h.absorbed == 0,
+          "on close the view is the body plus where the head is now", "yaw %.4f want %.4f absorbed %u", game[1], at_pause + 40, h.absorbed);
+
+    /* The game turns the player itself during a pause (a dialogue facing
+       the speaker): that stands, and the head turns on from it. */
+    in.play = 0;
+    hl_step(&h, &in, game);
+    game[1] = -20;
+    in.head_yaw = 140;
+    hl_step(&h, &in, game);
+    in.play = 1;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], -10, 1e-4) && h.absorbed == 1, "a turn the game made in a dialogue is kept", "yaw %.4f absorbed %u", game[1],
+          h.absorbed);
+    /* And during play (a teleport, a real mouse). */
+    game[1] += 33;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], 23, 1e-4) && h.absorbed == 2, "so is one the game made in play", "yaw %.4f", game[1]);
+
+    /* The host stops (mono, or the head lost): nothing written and no
+       pose; when it comes back the view does not jump. */
+    in.host_on = 0;
+    w = hl_step(&h, &in, game);
+    check(!w && !h.pose_valid, "with no head pose the camera is the game's and no pose is recorded", "w %d pose %d", w, h.pose_valid);
+    game[1] = 77;
+    in.host_on = 1;
+    in.head_yaw = -60;
+    hl_step(&h, &in, game);
+    check(game[1] == 77 && h.starts == 2, "a new start anchors where the game looks", "yaw %.4f starts %u", game[1], h.starts);
+    in.have_angles = 0;
+    w = hl_step(&h, &in, game);
+    check(!w && !h.pose_valid, "no angles to read (no map) is the same as no head", "w %d", w);
+
+    /* Started under a menu: anchored at the first frame in play, so the
+       head's turn in the menu does not move the view. */
+    in.have_angles = 1;
+    in.play = 0;
+    in.head_yaw = 0;
+    game[1] = 15;
+    hl_step(&h, &in, game);
+    in.head_yaw = 70;
+    hl_step(&h, &in, game);
+    in.play = 1;
+    hl_step(&h, &in, game);
+    check(game[1] == 15 && h.starts == 3, "a start under a menu anchors when play begins", "yaw %.4f starts %u", game[1], h.starts);
+}
+
+/* 10,000 game frames of a wandering head and a turning stick, the game
+   storing each write as float and keeping its yaw in 0..360 as an
+   anglemod would: every frame's yaw is the exact body plus head, nothing
+   is taken for a turn of the game's, and a head back at the start with
+   the turns undone is the starting yaw again. */
+static void head_look_drift(void)
+{
+    rt_headlook h;
+    rt_headlook_init(&h);
+    rt_headlook_in in = {.host_on = 1, .head_yaw = 10, .play = 1, .have_angles = 1};
+    float game[3] = {0, 45, 0};
+    hl_step(&h, &in, game);
+    double body = 45, ref = 10, worst = 0, turned = 0;
+    uint32_t seed = 12345;
+    for (int i = 0; i < 10000; i++) {
+        seed = seed * 1664525u + 1013904223u;
+        double r = (double)(seed >> 8) / (1 << 24) - 0.5;
+        in.head_yaw = (float)rt_headlook_wrap(in.head_yaw + r * 7.0);
+        in.head_pitch = (float)(40.0 * sin(i * 0.01));
+        if (i % 97 < 30) {
+            in.turn = (i % 2 ? 1 : -1) * 0.8;
+            turned += in.turn;
+            body += in.turn;
+        }
+        game[1] = fmodf(game[1] + 360.0f, 360.0f);
+        hl_step(&h, &in, game);
+        double want = rt_headlook_wrap(body + rt_headlook_diff(ref, in.head_yaw));
+        double err = fabs(rt_headlook_diff(want, game[1]));
+        if (err > worst) worst = err;
+    }
+    check(worst < 1e-3 && h.absorbed == 0, "10,000 frames: each yaw is the body plus the head to 0.001 degrees, nothing taken for the game's",
+          "worst %.6f absorbed %u", worst, h.absorbed);
+    in.head_yaw = 10;
+    in.turn = -turned;
+    in.head_pitch = 0;
+    hl_step(&h, &in, game);
+    check(near_deg(game[1], 45, 1e-3), "and back where it started is the starting yaw: no drift", "yaw %.6f", game[1]);
+}
+
+/* Route (b): the write goes to the engine's QAngle as three floats, the
+   way SetViewAngles copies it, on a fake one in guest memory. */
+static void head_look_write(void)
+{
+    const uint32_t va = 0x30100000u;
+    float *q = rt_host(va);
+    q[0] = 4.0f;
+    q[1] = -170.0f;
+    q[2] = 2.5f;
+    rt_headlook h;
+    rt_headlook_init(&h);
+    rt_headlook_in in = {.host_on = 1, .head_yaw = 0, .head_pitch = 10, .play = 1};
+    int w1 = rt_input_head_apply(&h, &in, va);
+    check(w1 && q[0] == -10.0f && q[1] == -170.0f && q[2] == 2.5f,
+          "the view angles are written in place: pitch from the head, yaw kept at the start, roll left alone", "%d %.3f %.3f %.3f", w1, q[0],
+          q[1], q[2]);
+    in.head_yaw = 25;
+    rt_input_head_apply(&h, &in, va);
+    check(q[1] == -145.0f, "a head turn is the angle the next frame reads", "yaw %.3f", q[1]);
+    rt_headlook_in none = {.host_on = 1, .play = 1};
+    int w0 = rt_input_head_apply(&h, &none, 0);
+    check(!w0 && !h.pose_valid, "no angle store, nothing written", "w %d", w0);
+}
+
+/* The right stick under head look: it turns the body, smoothly or in
+   snaps, and sends no mouse look. */
+static void pad_turn(void)
+{
+    rt_pad p;
+    rt_pad_defaults(&p);
+    int dx, dy;
+    p.mode = RT_PAD_PLAY;
+    p.rx = 32767;
+    rt_pad_move(&p, 0.01, &dx, &dy);
+    check(dx > 0 && rt_pad_take_turn(&p) == 0, "without head look the right stick still looks", "dx %d", dx);
+    p.head = 1;
+    p.ry = 32767;
+    rt_pad_move(&p, 0.5, &dx, &dy);
+    double t = rt_pad_take_turn(&p);
+    check(dx == 0 && dy == 0 && fabs(t + RT_PAD_TURN_SPEED * 0.5) < 1e-9,
+          "with head look a full right push turns right at the turn speed, and up and down do nothing", "dx %d dy %d turn %.4f", dx, dy, t);
+    check(rt_pad_take_turn(&p) == 0, "a turn is taken once", "left %.4f", p.turn_deg);
+    p.rx = 4000;
+    rt_pad_move(&p, 0.5, &dx, &dy);
+    check(rt_pad_take_turn(&p) == 0, "inside the dead zone nothing turns", "%.4f", p.turn_deg);
+    check(rt_pad_tune(&p, "turn", "snap") == 0 && p.turn_mode == RT_PAD_TURN_SNAP && rt_pad_tune(&p, "turn", "sideways") == -2,
+          "turn=snap is taken, a bad value is not", "mode %d", p.turn_mode);
+    p.rx = 32767;
+    rt_pad_move(&p, 0.01, &dx, &dy);
+    double s1 = rt_pad_take_turn(&p);
+    for (int i = 0; i < 50; i++) rt_pad_move(&p, 0.01, &dx, &dy);
+    double s2 = rt_pad_take_turn(&p);
+    p.rx = 0;
+    rt_pad_move(&p, 0.01, &dx, &dy);
+    p.rx = -32767;
+    rt_pad_move(&p, 0.01, &dx, &dy);
+    double s3 = rt_pad_take_turn(&p);
+    check(s1 == -RT_PAD_SNAP_DEG && s2 == 0 && s3 == RT_PAD_SNAP_DEG, "snap: one 45 degree step a push, held or not, either way",
+          "%.1f %.1f %.1f", s1, s2, s3);
+    check(rt_pad_tune(&p, "snap_angle", "30") == 0 && p.snap_deg == 30 && rt_pad_tune(&p, "turn_speed", "0") == -2,
+          "snap_angle and turn_speed are tunable within range", "%.1f", p.snap_deg);
+}
+
+/* Create plus Options recentres, in play; Options alone is still the
+   game's menu, and the chord opens no character sheet. */
+static void pad_recentre(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_BACK, 1);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && s.head_recentres == 1, "Create + Options asks for a recentre and sends the game nothing", "%s recentres %u", dump(),
+          s.head_recentres);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 0);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_BACK, 0);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && s.head_recentres == 1, "letting go opens neither the menu nor the character sheet", "%s", dump());
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 1);
+    padpump(&s, &d, 10);
+    check(s_n >= 1 && s_m[0].msg == WM_KEYDOWN && s_m[0].wp == 0x1B, "Options alone is still Escape, on its press", "%s", dump());
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_START, 0);
+    padpump(&s, &d, 10);
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
