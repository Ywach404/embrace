@@ -1246,8 +1246,8 @@ static void pad_map_mode(rt_input_state *s, rt_pad_dev *d, SDL_JoystickID id, in
         padpump(s, d, 10);
         snprintf(name, sizeof name, "%s %s press", mn, k_padmap[i].name);
         /* Options, Square and Circle in play have holds (the view toggle,
-           the head look switch and reload), so they wait and are a tap on
-           the release (pad_hold, pad_headlook). */
+           the head look switch and reload), so they are a tap on the
