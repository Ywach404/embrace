         if (mode == RT_PAD_PLAY && (k_padmap[i].btn == SDL_GAMEPAD_BUTTON_START || k_padmap[i].btn == SDL_GAMEPAD_BUTTON_WEST ||
                                     k_padmap[i].btn == SDL_GAMEPAD_BUTTON_EAST)) {
             check(s_n == 0, name, "%s", dump());
@@ -2384,8 +2384,57 @@ static void pad_reload_one(const char *pad)
     padpump(&s, &d, 10);
 }
 
+/* Both stick clicks are the host's (the view switch, the layout
+   editor), so in play the game gets neither, in either order: L3 sends
+   nothing in play, R3 alone crouches at once and is let go when L3
+   joins it. */
+static void pad_sticks(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 1);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 0);
+    padpump(&s, &d, 10);
+    check(s_n == 0, "L3 alone in play sends nothing", "%s", dump());
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 1);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_RIGHT_STICK, 1);
+    padpump(&s, &d, 2000);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_RIGHT_STICK, 0);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 0);
+    padpump(&s, &d, 10);
+    check(s_n == 0, "L3 then R3 held together sends the game nothing", "%s", dump());
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_RIGHT_STICK, 1);
+    padpump(&s, &d, 10);
+    int crouch = s_n == 1 && s_m[0].msg == WM_KEYDOWN;
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 1);
+    padpump(&s, &d, 10);
+    int let_go = s_n == 1 && s_m[0].msg == WM_KEYUP;
+    s_n = 0;
+    padpump(&s, &d, 2000);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_LEFT_STICK, 0);
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_RIGHT_STICK, 0);
+    padpump(&s, &d, 10);
+    check(crouch && let_go && s_n == 0, "R3 then L3: crouch goes out, is let go as L3 joins, and the releases send nothing",
+          "crouch %d let go %d %s", crouch, let_go, dump());
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
+
 static void pad_hold(void)
 {
+    pad_sticks();
     pad_hold_one("PlayStation VR2 Sense Controllers (L/R)");
     pad_hold_one("DualSense Wireless Controller");
     pad_reload_one("PlayStation VR2 Sense Controllers (L/R)");
