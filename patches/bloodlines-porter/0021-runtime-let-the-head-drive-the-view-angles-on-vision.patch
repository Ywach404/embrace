diff --git a/runtime/headlook.c b/runtime/headlook.c
new file mode 100644
index 0000000..c27d3b1
--- /dev/null
+++ b/runtime/headlook.c
@@ -0,0 +1,85 @@
+#include "headlook.h"
+
+#include <math.h>
+#include <string.h>
+
+double rt_headlook_wrap(double a)
+{
+    a = fmod(a, 360.0);
+    if (a > 180.0) a -= 360.0;
+    if (a <= -180.0) a += 360.0;
+    return a;
+}
+
+double rt_headlook_diff(double a, double b) { return rt_headlook_wrap(b - a); }
+
+void rt_headlook_init(rt_headlook *h)
+{
+    memset(h, 0, sizeof *h);
+    h->pitch_down = RT_HEADLOOK_PITCH_DOWN;
+    h->pitch_up = RT_HEADLOOK_PITCH_UP;
+}
+
+int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3])
+{
+    if (!in->host_on || !in->have_angles) {
+        /* The game's camera is its own again: nothing recorded, and the
+           next start anchors afresh. */
+        h->on = h->anchored = h->playing = h->wrote = h->pose_valid = 0;
+        return 0;
+    }
+    h->on = 1;
+    if (!in->play) {
+        if (h->playing) h->pauses++;
+        h->playing = 0;
+        return 0;
+    }
+    h->playing = 1;
+    if (!h->anchored) {
+        /* Anchored so the view does not turn: the head's facing now is
+           straight ahead and the body is where the game looks. Pitch is
+           the head's own from the first write. */
+        h->anchored = 1;
+        h->starts++;
+        h->ref = in->head_yaw;
+        h->body = in->game[1];
+        h->wrote = 0;
+    }
+    if (h->wrote) {
+        double d = rt_headlook_diff(h->written[1], in->game[1]);
+        if (fabs(d) > RT_HEADLOOK_EPS_DEG) {
+            h->body += d;
+            h->absorbed++;
+        }
+    }
+    h->body = rt_headlook_wrap(h->body + in->turn);
+    double head = rt_headlook_diff(h->ref, in->head_yaw);
+    if (in->recentre) {
+        /* The body takes the view's heading and the head's facing now is
+           the new straight ahead, so the view itself does not move. */
+        h->body = rt_headlook_wrap(h->body + head);
+        h->ref = in->head_yaw;
+        head = 0;
+        h->recentres++;
+    }
+    float yaw = (float)rt_headlook_wrap(h->body + head);
+    float pitch = -in->head_pitch;
+    if (pitch > h->pitch_down || pitch < -h->pitch_up) {
+        pitch = pitch > h->pitch_down ? h->pitch_down : -h->pitch_up;
+        h->clamps++;
+    }
+    out[0] = pitch;
+    out[1] = yaw;
+    out[2] = in->game[2];
+    h->written[0] = pitch;
+    h->written[1] = yaw;
+    h->wrote = 1;
+    h->writes++;
+    /* The frame is drawn for the head's heading and the pitch actually
+       written: past a limit the image stays at the limit, and the late
+       rotation then shows it there rather than where the head is. */
+    h->pose_valid = 1;
+    h->pose_yaw = in->head_yaw;
+    h->pose_pitch = -pitch;
+    return 1;
+}
diff --git a/runtime/headlook.h b/runtime/headlook.h
new file mode 100644
index 0000000..61a520a
--- /dev/null
+++ b/runtime/headlook.h
@@ -0,0 +1,82 @@
+#ifndef RT_HEADLOOK_H
+#define RT_HEADLOOK_H
+
+#include <stdint.h>
+
+/*
+ * Head look (visionOS, stereo): the game's view angles follow the head.
+ * Each game frame the view's yaw is the body's yaw plus the head's yaw
+ * since the reference, and its pitch is the head's own pitch, clamped to
+ * the game's limits. The game cannot roll; the compositor keeps the world
+ * level instead (immersive.h, mtl_late_rotation).
+ *
+ * The angles are written absolutely, never sent as mouse counts, so
+ * nothing accumulates: a frame's yaw is a sum of two numbers held here,
+ * not of every delta so far. What the game itself does to the yaw
+ * between two writes (a spawn or teleport facing, a script, a real
+ * mouse) is found by comparing the game's yaw with the last one written,
+ * and taken into the body, so the game's turns stand and the head turns
+ * on from there.
+ *
+ * Play only: a menu, a dialogue or the character sheet pauses it. The
+ * view is then the game's, and the pose each frame records (for the
+ * compositor's late rotation) stays the one last applied, so the plane
+ * stays world locked where the head left it. The body is kept through a
+ * pause, so on resume the view is the body plus wherever the head is
+ * now: the same world, seen from the head's new direction.
+ *
+ * Pure: no guest memory, no clock. input.c reads and writes the angles.
+ *
+ * Conventions: head angles are ARKit's (degrees, yaw positive turning
+ * left from -Z, pitch positive up); view angles are the game's (pitch,
+ * yaw, roll in degrees, pitch positive down, yaw positive left).
+ */
+
+/* The game's pitch limits: down is positive. */
+#define RT_HEADLOOK_PITCH_DOWN 89.0f
+#define RT_HEADLOOK_PITCH_UP 89.0f
+/* A game yaw further than this from the last one written was turned by
+   the game. The store is a plain float the engine copies untouched, but
+   the margin also covers any rounding of the angle on its way back
+   (a 16-bit angle is 0.0055 degrees), while a turn the game means
+   (a spawn facing, a teleport, a dialogue's look-at) is tens of degrees. */
+#define RT_HEADLOOK_EPS_DEG 0.05
+
+typedef struct {
+    int host_on;           /* the host gives a head pose: stereo is shown and the head is tracked */
+    float head_yaw, head_pitch;
+    int play;              /* in play: no menu, dialogue or character sheet */
+    double turn;           /* body turn from the stick since the last step, degrees, positive left */
+    int recentre;          /* a recentre was asked since the last step */
+    int have_angles;       /* the game's angles were read into game[] */
+    float game[3];         /* the game's view angles now: pitch, yaw, roll */
+} rt_headlook_in;
+
+typedef struct {
+    float pitch_down, pitch_up;
+    /* on: the host gives a pose. anchored: body and ref are set, at the
+       first step in play after on, so a start under a menu does not
+       carry the head's turn in the menu into the view. A pause keeps
+       the anchoring; the host switching off ends it. playing: the last
+       step was in play. */
+    int on, anchored, playing;
+    double body, ref;      /* body yaw (game degrees) and the head yaw at which the head adds nothing */
+    int wrote;             /* written[] holds what was last written */
+    float written[2];      /* pitch, yaw */
+    /* The head pose the latest written angles stand for, as the frame's
+       record (immersive.h): valid, yaw, pitch up. */
+    int pose_valid;
+    float pose_yaw, pose_pitch;
+    uint32_t starts, absorbed, recentres, writes, pauses, clamps;
+} rt_headlook;
+
+void rt_headlook_init(rt_headlook *h);
+/* One game frame. Returns 1 with out[] (pitch, yaw, roll) to be written
+   as the game's view angles, else 0 and nothing to write. */
+int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3]);
+/* b - a, wrapped into -180..180. */
+double rt_headlook_diff(double a, double b);
+/* Into -180..180. */
+double rt_headlook_wrap(double a);
+
+#endif
