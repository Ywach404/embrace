+/* A fake dialogue HUD in guest memory, laid out as the game's: the
+   selector finds it through dialogue_va as the pump's probe would. */
+#define FAKE_VA 0x30000000u
+#define FAKE_SIZE 0x5A84u
+#define DIALOGUE_HISTORY_OFF 0x1B2u
+#define DIALOGUE_SINGLE_OFF 0x1B3u
+#define DIALOGUE_ACTIVE_OFF 0x1B4u
+#define DIALOGUE_COUNT_OFF 0x1228u
+#define DIALOGUE_TEXT_OFF 0x122Cu
+#define DIALOGUE_TYPE_OFF 0x322Cu
+#define DIALOGUE_FLAGS_OFF 0x323Cu
+#define DIALOGUE_PICK_OFF 0x5A80u
+
+static const char *const k_pad_answer[RT_DLG_SLOTS] = {"Who are you?", "What is this place?", "Go on.", "Goodbye."};
+static char s_fake[RT_DLG_SLOTS][RT_DLG_TEXT];
+
+static char *fake_slot(int i) { return (char *)rt_host(FAKE_VA + DIALOGUE_TEXT_OFF + (uint32_t)i * RT_DLG_TEXT); }
+
+static void fake8(uint32_t off, uint8_t v) { *(uint8_t *)rt_host(FAKE_VA + off) = v; }
+
+static void fake32(uint32_t off, uint32_t v) { memcpy(rt_host(FAKE_VA + off), &v, sizeof v); }
+
+/* As the game's Q_strncpy writes a slot: the text, then zeros. */
+static void fake_text(int i, const char *t)
+{
+    memset(s_fake[i], 0, RT_DLG_TEXT);
+    strncpy(s_fake[i], t, RT_DLG_TEXT - 1);
+    memcpy(fake_slot(i), s_fake[i], RT_DLG_TEXT);
+}
+
+static void fake_open(int32_t count)
+{
+    memset(rt_host(FAKE_VA), 0, FAKE_SIZE);
+    fake8(DIALOGUE_ACTIVE_OFF, 1);
+    fake32(DIALOGUE_COUNT_OFF, (uint32_t)count);
+    for (int i = 0; i < RT_DLG_SLOTS; i++) {
+        fake_text(i, k_pad_answer[i]);
+        fake32(DIALOGUE_TYPE_OFF + 4u * (uint32_t)i, (uint32_t)i + 1);
+    }
+}
+
+/* The slot showing the marker over its own text, or -1. */
+static int marked(void)
+{
+    for (int i = 0; i < RT_DLG_SLOTS; i++) {
+        const char *t = fake_slot(i);
+        if (t[0] == '>' && t[1] == ' ' && !strncmp(t + 2, s_fake[i], RT_DLG_TEXT - 3)) return i;
+    }
+    return -1;
+}
+
+/* Every slot but the one given holds the game's own bytes. */
+static int fake_clean_except(int keep)
+{
+    for (int i = 0; i < RT_DLG_SLOTS; i++)
+        if (i != keep && memcmp(fake_slot(i), s_fake[i], RT_DLG_TEXT)) return 0;
+    return 1;
+}
