 runtime/input.h          |   5 +
 runtime/input_selftest.c | 219 +++++++++++++++++++++++++++++++++++----
 runtime/pad.c            |  82 +++++++++++----
 runtime/pad.h            |  23 +++-
 5 files changed, 330 insertions(+), 53 deletions(-)

diff --git a/runtime/input.c b/runtime/input.c
index 16d7441..ce55f2f 100644
--- a/runtime/input.c
+++ b/runtime/input.c
@@ -344,6 +344,9 @@ int rt_input_translate(rt_input_state *s, const SDL_Event *e, const rt_present_r
 #define DIALOGUE_TYPE 0x322Cu
 #define DIALOGUE_FLAGS 0x323Cu
 #define DIALOGUE_PICK_TIME 0x5A80u
+/* The HUD's own relayout flag: its setters for history (sub_10554BD0)
+   and single-line mode raise it when the value changes. */
+#define DIALOGUE_DIRTY 0x190u
 
 /* Host time since the last pick before a confirm is sent. The game's
    own guard is 0.5 s on its clock; a pick it makes is seen here a pump
@@ -473,6 +476,30 @@ static int sel_ready(uint32_t va)
     return va && panel8(va + DIALOGUE_ACTIVE) && !panel8(va + DIALOGUE_HISTORY) && !panel8(va + DIALOGUE_SINGLE);
 }
 
+/* The history view off, as the HUD's own setter turns it off: the flag
+   cleared and the relayout raised. The HUD's Key_Event (sub_10555260)
+   flips the view on every mouse1 key event (key 0xF1, through
+   sub_10554B60), and the HUD hears every key in play as well as in a
+   dialogue, so the trigger's punches leave it on or off at random. A
+   dialogue that opens with it on shows the past lines over the answers,
+   and the selector would refuse every step there. */
+static void history_off(uint32_t va)
+{
+    *(uint8_t *)rt_host(va + DIALOGUE_HISTORY) = 0;
+    *(uint8_t *)rt_host(va + DIALOGUE_DIRTY) = 1;
+}
+
+/* Why a step was refused, once a dialogue, so a run log tells it. */
+static void sel_refused(rt_dialogue_sel *g, uint32_t va, int32_t count)
+{
+    if (g->refused) return;
+    g->refused = 1;
+    if (!va) rt_log("dialogue step refused: no dialogue panel");
+    else
+        rt_log("dialogue step refused: active %d history %d single %d count %d", panel8(va + DIALOGUE_ACTIVE),
+               panel8(va + DIALOGUE_HISTORY), panel8(va + DIALOGUE_SINGLE), (int)count);
+}
+
 /* Anything that changes the answers other than our own edit ends the
    highlight, so a confirm can never send the number of an answer the
    player did not see marked. A slot rewritten to the same text it had
@@ -544,7 +571,7 @@ static void sel_check(rt_dialogue_sel *g, uint32_t va, uint64_t now)
    a dialogue: a keyboard player sees the game's own text. */
 static void sel_auto(rt_dialogue_sel *g, uint32_t va, uint64_t now, int can_auto)
 {
-    if (!va || !panel8(va + DIALOGUE_ACTIVE)) g->skip_on = g->await_on = 0;
+    if (!va || !panel8(va + DIALOGUE_ACTIVE)) g->skip_on = g->await_on = g->refused = 0;
     if (g->lit || !sel_ready(va)) return;
     int32_t count = (int32_t)panel32(va + DIALOGUE_COUNT);
     uint32_t key = set_key(va, count);
@@ -570,6 +597,14 @@ static void sel_sync(rt_input_state *s, uint64_t now, int can_auto)
         g->pick_bits = bits;
     }
     if (g->lit) sel_check(g, va, now);
+    /* With no dialogue the history view is nobody's: a punch left it on.
+       Off now, so the next dialogue opens on its answers. */
+    if (va && !panel8(va + DIALOGUE_ACTIVE) && panel8(va + DIALOGUE_HISTORY)) {
+        history_off(va);
+        if (++g->history_cleared <= 8)
+            rt_log("dialogue history view was on outside a dialogue (mouse1 flips it), turned off (%u this run)%s", g->history_cleared,
+                   g->history_cleared == 8 ? "; no more of these" : "");
+    }
     sel_auto(g, va, now, can_auto);
 }
 
@@ -593,9 +628,20 @@ static int sel_act(rt_input_state *s, int act, uint64_t now, SDL_Event *out, int
     switch (act) {
     case RT_PAD_ACT_UP:
     case RT_PAD_ACT_DOWN: {
-        if (!sel_ready(va)) return 0;
-        int32_t count = (int32_t)panel32(va + DIALOGUE_COUNT);
-        if (count <= 0 || count > DIALOGUE_COUNT_MAX) return 0;
+        int32_t count = va ? (int32_t)panel32(va + DIALOGUE_COUNT) : 0;
+        /* A step is the player asking for the answers, so a history view
+           over them is closed first; single-line mode shows none, and is
+           the server's to end. */
+        if (va && panel8(va + DIALOGUE_ACTIVE) && panel8(va + DIALOGUE_HISTORY) && !panel8(va + DIALOGUE_SINGLE) && count > 0 &&
+            count <= DIALOGUE_COUNT_MAX) {
+            history_off(va);
+            g->history_closes++;
+            rt_log("dialogue history view closed for the answers (%u this run)", g->history_closes);
+        }
+        if (!sel_ready(va) || count <= 0 || count > DIALOGUE_COUNT_MAX) {
+            sel_refused(g, va, count);
+            return 0;
+        }
         /* The first move marks the first answer whichever way it goes:
            nothing is marked, so there is no "next" to go to. */
         int idx = !g->lit ? 0 : g->idx + (act == RT_PAD_ACT_UP ? -1 : 1);
