+/* The arms: the game draws its first person hands as a model of their
+   own, view model 1 in A.'s gun run (2026-11-25), hands/male/shared/
+   v_shared_male_hands.mdl with Bip01 L Hand at 8 and Bip01 R Hand at 27,
+   whatever the weapon. View model 0 is the weapon, whose own hand bones
+   are zero or absent. The arms' cached bones are only made with no weapon
+   out; with one out they stay as they were, so the renderer takes the
+   hands from the arms' own draws instead (draw.m, arm_hands), which needs
+   only the hand's place in the model's bind pose from here. */
+static int is_arms(const vm_model *m)
+{
+    return has_word(m->model, "hands");
+}
+
+static int zero_bone(const vm_model *m, int i)
+{
+    float b[12];
+    memcpy(b, rt_host(m->bones + (uint32_t)i * 48u), sizeof b);
+    for (int k = 0; k < 12; k++)
+        if (b[k] != 0.0f) return 0;
+    return 1;
+}
+
+/* A bone by its exact name, or -1. */
+static int bone_named(const vm_model *m, const char *want)
+{
+    for (int i = 0; i < m->n; i++) {
+        char nm[48];
+        bone_name(m, i, nm);
+        if (!strcmp(nm, want)) return i;
+    }
+    return -1;
+}
