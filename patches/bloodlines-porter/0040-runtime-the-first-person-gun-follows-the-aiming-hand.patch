+/* Bound on every platform: a lift with the rows calls through the cells
+   on each CreateMove and each view model pose, and the shims do nothing
+   more than the stock code off visionOS. A lift without them keeps the
+   stock code and nothing is bound. A site that matches neither is logged
+   and left alone, since the game plays the same without hand aim. */
+static void view_model_init(void)
+{
+    static const uint8_t vm_old[5] = {0xe8, 0x2d, 0xf7, 0xff, 0xff};
+    uint32_t va = rt_hook_va("client", VM_SITE_RVA);
+    if (!va) return;
+    if (rt_hook_claimed(va, sizeof vm_old)) {
+        rt_log("hand aim: view model site 0x%08X owned by another hook", va);
+        return;
+    }
+    int st = rt_hook_site("hand_aim_view_model", va, vm_old, sizeof vm_old, -1, 0xE8, VM_CELL, &k_hand_aim_view_model);
+    if (st == RT_HOOK_BAKED)
+        rt_log("hand aim: view model on (build), its pose at 0x%08X through cell %u", va, VM_CELL);
+    else if (st == RT_HOOK_ABSENT)
+        rt_log("hand aim: view model not in this build");
+    else
+        rt_log("hand aim: bytes at 0x%08X match neither the stock call nor the build's", va);
+}
 
