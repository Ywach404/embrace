@@ -40,7 +44,7 @@ static const int k_sdl[RT_PAD_NBTN] = {
    that handler drops the same way, so a power fired once and then not
    again; the runtime binds f7 to it at launch (trace.c). */
 static const char *const k_default[RT_PAD_NBTN] = {"space", "e",      "i",    "f",    "c",    "escape", "wheeldown", "wheelup",
-                                                   "l",     "lctrl",  "1",    "3",    "4",    "2",      "f7",        "return",
+                                                   "none",  "lctrl",  "1",    "3",    "4",    "2",      "f7",        "return",
                                                    "r",     "r",      "none", "none", "none", "none"};
 
 /* Where menu and dialogue modes differ. In menus Cross clicks so the
@@ -58,6 +62,7 @@ static const struct {
     {RT_PAD_MENU, 2, "i"},
     {RT_PAD_MENU, RT_PAD_LT, "mouse2"},
     {RT_PAD_MENU, RT_PAD_RT, "mouse1"},
+    {RT_PAD_MENU, RT_PAD_L3, "l"},
     /* The dialogue HUD (client CHudDialog::Key_Event) answers only to the
        number keys, picking on release, and has no highlight of its own,
        so input.c keeps one: either stick's up and down flicks and the
@@ -74,6 +79,7 @@ static const struct {
     {RT_PAD_DIALOGUE, 0, "answer/space"},
     {RT_PAD_DIALOGUE, 1, "answerclear/escape"},
     {RT_PAD_DIALOGUE, RT_PAD_RT, "answer"},
+    {RT_PAD_DIALOGUE, RT_PAD_L3, "l"},
     {RT_PAD_DIALOGUE, 10, "answerup"},
     {RT_PAD_DIALOGUE, 11, "answerdown"},
     {RT_PAD_DIALOGUE, 12, "none"},
@@ -554,6 +560,18 @@ int rt_pad_button(rt_pad *p, int idx, int down, rt_pad_pt pt, SDL_Event *out, in
                    ++p->chords_fired);
             return emit(&p->held[idx], 1, pt, out, cap);
         }
+    /* Both stick clicks together belong to the host (the view switch, and
+       the layout editor when held), so in play they reach the game as
+       nothing: L3 sends nothing there, and R3 lets go of its crouch as L3
+       joins. */
+    if (p->mode == RT_PAD_PLAY && (idx == RT_PAD_L3 || idx == RT_PAD_R3) && p->down[idx == RT_PAD_L3 ? RT_PAD_R3 : RT_PAD_L3]) {
+        int n = 0;
+        if (idx == RT_PAD_L3) n = emit(&p->held[RT_PAD_R3], 0, pt, out, cap);
+        p->held[RT_PAD_R3] = (rt_pad_tgt){RT_PADT_NONE, 0, RT_PADT_NONE, 0};
+        p->held[idx] = p->held[RT_PAD_R3];
+        rt_log("pad: both stick clicks are the host's; the game gets neither");
+        return n;
+    }
     rt_pad_tgt t = *rt_pad_target(p, idx, p->mode);
     if ((t.kind == RT_PADT_ANSWER || t.kind == RT_PADT_ANSWER_CLEAR) && !p->lit) t = (rt_pad_tgt){t.alt_kind, t.alt_arg, RT_PADT_NONE, 0};
     p->held[idx] = t;
