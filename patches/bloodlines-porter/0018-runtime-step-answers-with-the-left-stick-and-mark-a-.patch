+/* A left stick push for one pump, then where it is left. */
+static void lstick(rt_input_state *s, rt_pad_dev *d, SDL_JoystickID id, int x, int y)
+{
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTX, x);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTY, y);
+    padpump(s, d, 10);
+}
+
+/* A movement key pressed in what was sent: W, A, S or D. */
+static int walked(void)
+{
+    for (int i = 0; i < s_n; i++)
+        if (s_m[i].msg == WM_KEYDOWN && (s_m[i].wp == 0x57 || s_m[i].wp == 0x41 || s_m[i].wp == 0x53 || s_m[i].wp == 0x44)) return 1;
+    return 0;
+}
+
+static void dialogue_on(rt_input_state *s, int on)
+{
+    fake8(DIALOGUE_ACTIVE_OFF, (uint8_t)on);
+    s->dialogue = on;
+    /* The probe keeps the HUD's address while it is inactive. */
+    s->dialogue_va = FAKE_VA;
+}
+
+/* The left stick is the primary way through the answers: it steps as
+   the right stick does, never walks in a dialogue, and like the right
+   one has to centre after the dialogue opens before it steps. */
+static void pad_left(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("DualSense Wireless Controller");
+    padpump(&s, &d, 10);
+    fake_open(4);
+    s_n = 0;
+    lstick(&s, &d, id, 0, -32767);
+    check(sent_at(WM_KEYDOWN, 0x57) >= 0, "in play the left stick walks", "%s", dump());
+
+    /* Both sticks held as the dialogue opens: the walk key is lifted and
+       neither steps. */
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHTY, 32767);
+    s_n = 0;
+    dialogue_on(&s, 1);
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(sent_at(WM_KEYUP, 0x57) >= 0 && !walked() && marked() == -1,
+          "a dialogue opening under both sticks lifts the walk key and steps nothing", "%s slot %d", dump(), marked());
+
+    /* The left stick centres and steps; the right, held since the open,
+       still does not. */
+    s_n = 0;
+    lstick(&s, &d, id, 0, 0);
+    lstick(&s, &d, id, 0, 32767);
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 0 && s_n == 0, "the left stick, once centred, marks the first answer while the right, held since the open, does not",
+          "slot %d %s", marked(), dump());
+    lstick(&s, &d, id, 0, 32767);
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 1, "left down steps to the second answer", "slot %d", marked());
+    lstick(&s, &d, id, 0, -32767);
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 0, "left up steps back", "slot %d", marked());
+    lstick(&s, &d, id, 32767, 0);
+    lstick(&s, &d, id, -32767, 0);
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 0 && s_n == 0, "left and right on the left stick do nothing", "slot %d %s", marked(), dump());
+    rstick(&s, &d, id, 0, 0);
+    rstick(&s, &d, id, 0, 32767);
+    rstick(&s, &d, id, 0, 0);
+    check(marked() == 1 && s_n == 0, "the right stick steps too once it has centred", "slot %d %s", marked(), dump());
+
+    /* Repeat on the left stick: once on the push, again at 0.4 s, then
+       every 0.15 s, and never a walk key. */
+    lstick(&s, &d, id, 0, -32767);
+    lstick(&s, &d, id, 0, 0);
+    s_n = 0;
+    int32_t hx = s.x, hy = s.y;
+    lstick(&s, &d, id, 0, 32767);
+    check(marked() == 1, "a held left stick steps once on the push", "slot %d", marked());
+    for (int i = 0; i < 39; i++) padpump(&s, &d, 10);
+    check(marked() == 1, "and not again before 0.4 s", "slot %d", marked());
+    padpump(&s, &d, 10);
+    check(marked() == 2, "it repeats at 0.4 s", "slot %d", marked());
+    for (int i = 0; i < 14; i++) padpump(&s, &d, 10);
+    check(marked() == 2, "and not again before another 0.15 s", "slot %d", marked());
+    padpump(&s, &d, 10);
+    check(marked() == 3, "then every 0.15 s", "slot %d", marked());
+    for (int i = 0; i < 60; i++) padpump(&s, &d, 10);
+    check(marked() == 3 && fake_clean_except(3), "held, it stops at the last answer", "slot %d", marked());
+    check(!walked() && s.x == hx && s.y == hy, "a left stick held in a dialogue never walks or moves the pointer", "%s at %d,%d", dump(),
+          s.x, s.y);
+    lstick(&s, &d, id, 0, 0);
+
+    /* A flick held on one stick stays with it: the other stick pushed
+       further does not take it over, nor step until the first lets go. */
+    lstick(&s, &d, id, 0, -20000);
+    check(marked() == 2, "a left flick up steps", "slot %d", marked());
+    rstick(&s, &d, id, 0, 32767);
+    check(marked() == 2, "the right stick pushed further while the left holds does not step", "slot %d", marked());
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 3, "the left letting go hands the step to the right, which is still out", "slot %d", marked());
+    rstick(&s, &d, id, 0, 0);
+
+    /* The reverse open: the left held from before, the right centred.
+       The right steps at once, the left only after centring. */
+    dialogue_on(&s, 0);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    lstick(&s, &d, id, 0, 32767);
+    check(sent_at(WM_KEYDOWN, 0x53) >= 0, "back in play the left stick walks again", "%s", dump());
+    fake_open(4);
+    s_n = 0;
+    dialogue_on(&s, 1);
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(marked() == -1 && sent_at(WM_KEYUP, 0x53) >= 0 && !walked(), "a left stick held from play into a dialogue does not step",
+          "slot %d %s", marked(), dump());
+    rstick(&s, &d, id, 0, 32767);
+    rstick(&s, &d, id, 0, 0);
+    check(marked() == 0, "a centred right stick steps at once", "slot %d", marked());
+    lstick(&s, &d, id, 0, 0);
+    lstick(&s, &d, id, 0, 32767);
+    lstick(&s, &d, id, 0, 0);
+    check(marked() == 1, "the left steps once it has been back to the centre", "slot %d", marked());
+
+    dialogue_on(&s, 0);
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
+
+/* A lone answer is marked as soon as it shows, so Cross confirms it with
+   no step first. */
+static void pad_lone(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("DualSense Wireless Controller");
+    padpump(&s, &d, 10);
+    fake_open(1);
+    s_n = 0;
+    dialogue_on(&s, 1);
+    padpump(&s, &d, 10);
+    check(marked() == 0 && s.sel.lit && s.sel.autos == 1 && s_n == 0 && fake_clean_except(0), "a lone answer is marked as it appears",
+          "slot %d lit %d %s", marked(), s.sel.lit, dump());
+
+    for (int32_t c = 2; c <= 4; c++) {
+        char name[80];
+        fake32(DIALOGUE_COUNT_OFF, (uint32_t)c);
+        for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+        snprintf(name, sizeof name, "%d answers are not marked until a move", c);
+        check(marked() == -1 && !s.sel.lit && fake_clean_except(-1), name, "slot %d", marked());
+    }
+    fake32(DIALOGUE_COUNT_OFF, 1);
+    padpump(&s, &d, 10);
+    check(marked() == 0 && s.sel.lit, "the count coming back to one marks it again", "slot %d", marked());
+
+    /* Cross confirms the marked lone answer as its number key. */
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(sent_at(WM_KEYDOWN, 0x31) >= 0 && sent_at(WM_KEYUP, 0x31) >= 0 && sent_at(WM_KEYDOWN, 0x20) < 0 && fake_clean_except(-1),
+          "Cross confirms the lone answer as 1, with its text restored", "%s", dump());
+    for (int i = 0; i < 10; i++) padpump(&s, &d, 10);
+    check(marked() == -1 && !s.sel.lit, "the answer just picked is not marked again while it is still shown", "slot %d", marked());
+
+    /* The game moves on to a node with the same single line: its pick
+       time moves, and the line is marked; Cross that soon waits out the
+       guard and keeps the mark. */
+    fake32(DIALOGUE_PICK_OFF, 0x3F800000u);
+    padpump(&s, &d, 10);
+    check(marked() == 0 && s.sel.lit, "the next lone answer, the same line, is marked once the game's pick time moves", "slot %d", marked());
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(s_n == 0 && marked() == 0 && s.sel.held == 1, "Cross on a lone answer right after a pick is held by the guard", "%s slot %d", dump(),
+          marked());
+    for (int i = 0; i < 50; i++) padpump(&s, &d, 10);
+    s_n = 0;
+    tap(&s, &d, id, PM_R2);
+    check(sent_at(WM_KEYDOWN, 0x31) >= 0 && marked() == -1, "past the guard RT confirms it", "%s", dump());
+
+    /* A pick among two answers that leads to a one-answer node. */
+    fake32(DIALOGUE_COUNT_OFF, 2);
+    fake32(DIALOGUE_PICK_OFF, 0x40000000u);
+    for (int i = 0; i < 60; i++) padpump(&s, &d, 10);
+    check(marked() == -1, "a two-answer node starts unmarked", "slot %d", marked());
+    dpad(&s, &d, id, SDL_GAMEPAD_BUTTON_DPAD_DOWN);
+    dpad(&s, &d, id, SDL_GAMEPAD_BUTTON_DPAD_DOWN);
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(sent_at(WM_KEYDOWN, 0x32) >= 0, "Cross picks the second of two", "%s", dump());
+    fake32(DIALOGUE_COUNT_OFF, 1);
+    fake_text(0, "I will be going.");
+    padpump(&s, &d, 10);
+    check(marked() == 0 && s.sel.lit, "a pick that leads to a one-answer node marks it", "slot %d", marked());
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(s_n == 0 && marked() == 0, "and Cross waits out the guard", "%s slot %d", dump(), marked());
+    for (int i = 0; i < 50; i++) padpump(&s, &d, 10);
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(sent_at(WM_KEYDOWN, 0x31) >= 0 && marked() == -1, "then confirms it", "%s", dump());
+
+    /* Circle clears the auto mark, and the same set is not marked again;
+       a new set is. */
+    fake32(DIALOGUE_PICK_OFF, 0x40400000u);
+    fake_text(0, "Fine.");
+    for (int i = 0; i < 60; i++) padpump(&s, &d, 10);
+    check(marked() == 0, "a new lone answer is marked", "slot %d", marked());
+    s_n = 0;
+    tap(&s, &d, id, PM_CIRCLE);
+    for (int i = 0; i < 20; i++) padpump(&s, &d, 10);
+    check(marked() == -1 && !s.sel.lit && fake_clean_except(-1) && s_n == 0, "Circle clears the auto mark and it is not put back",
+          "slot %d %s", marked(), dump());
+    fake8(DIALOGUE_HISTORY_OFF, 1);
+    padpump(&s, &d, 10);
+    fake8(DIALOGUE_HISTORY_OFF, 0);
+    padpump(&s, &d, 10);
+    check(marked() == -1, "nor after the history opens and closes over the same set", "slot %d", marked());
+    s_n = 0;
+    tap(&s, &d, id, PM_CROSS);
+    check(sent_at(WM_KEYDOWN, 0x20) >= 0 && sent_at(WM_KEYDOWN, 0x31) < 0, "Cross after Circle is space, the game's continue", "%s", dump());
+    dpad(&s, &d, id, SDL_GAMEPAD_BUTTON_DPAD_DOWN);
+    check(marked() == 0, "a step still marks the cleared answer by hand", "slot %d", marked());
+    tap(&s, &d, id, PM_CIRCLE);
+    fake_text(0, "Later.");
+    padpump(&s, &d, 10);
+    check(marked() == 0 && s.sel.lit, "once the answer changes the new one is marked", "slot %d", marked());
+
+    /* Not under a menu, and not without a pad driving. */
+    tap(&s, &d, id, PM_CIRCLE);
+    s.cursor = 0x00007F00u;
+    rt_input_relative_update(&s);
+    fake_text(0, "Under a menu.");
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(marked() == -1, "a lone answer under a menu is not marked", "slot %d", marked());
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    padpump(&s, &d, 10);
+    check(marked() == 0, "and is marked when the menu closes", "slot %d", marked());
