+/* Hand aim's view model (headlook.c): the hand's place from the head,
+   in the head's level frame, turned into the game's world by the view's
+   yaw and scaled to game units. */
+static void hand_place(void)
+{
+    const float upm = 1.0f / 0.0254f, none[3] = {0, 0, 0};
+    float aim[16], out[3];
+    float head[3] = {0.1f, 1.5f, -0.3f};
+    aim_at(0, 0, aim);
+    aim[12] = 0.1f, aim[13] = 1.5f, aim[14] = -0.6f;
+    rt_headlook_hand_offset(head, 0, aim, 0, upm, none, out);
+    check(fabsf(out[0] - 0.3f * upm) < 1e-3f && fabsf(out[1]) < 1e-3f && fabsf(out[2]) < 1e-3f,
+          "a hand 0.3 m ahead of the head, both facing yaw 0, is 0.3 m forward in the game", "%.4f %.4f %.4f", out[0], out[1],
+          out[2]);
+
+    aim[12] = 0.3f, aim[13] = 1.5f, aim[14] = -0.3f;
+    rt_headlook_hand_offset(head, 0, aim, 90, upm, none, out);
+    check(fabsf(out[0] - 0.2f * upm) < 1e-3f && fabsf(out[1]) < 1e-3f && fabsf(out[2]) < 1e-3f,
+          "a hand 0.2 m right of the head at game yaw 90 (facing +y) is 0.2 m along +x", "%.4f %.4f %.4f", out[0], out[1],
+          out[2]);
+
+    /* The same hand, head and room turned 40 degrees left together: the
+       game sees the same place. 0.2 right and 0.1 below, 0.3 ahead. */
