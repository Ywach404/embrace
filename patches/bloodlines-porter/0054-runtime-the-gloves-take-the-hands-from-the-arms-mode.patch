 }
+
+int rt_vm_hands(float pts[18])
+{
+    memset(pts, 0, 18 * sizeof *pts);
+    if (!rt_vm_bones_wanted()) return 0;
+    probe_models();
+    vm_model m;
+    /* The arms' cache, and only while it is this frame's: a stale cache
+       is where the hands were before the weapon came out. */
+    if (!arms_model(&m) || !m.fresh) return 0;
+    int hand[2];
+    find_hands(&m, hand);
+    int mask = 0;
+    for (int s = 0; s < 2; s++) {
+        if (hand[s] < 0 || zero_bone(&m, hand[s])) continue;
+        bone_points(&m, hand[s], pts + 9 * s);
+        if (finite_n(pts + 9 * s, 9)) mask |= 1 << s;
+        else memset(pts + 9 * s, 0, 9 * sizeof *pts);
+    }
+    return mask;
+}
+
+/* A bone's place in the bind pose: the inverse of its pose to bone
+   matrix (mstudiobone_t +0x60, a matrix3x4_t, after the name, parent,
+   controllers, position, quaternion, rotation and their scales; the
+   0xA0 a bone this build's header gives ends with the alignment
+   quaternion after it). 0 when that matrix is not a rigid turn, which
+   would mean the offset is wrong for this build. */
+static int bone_bind(const vm_model *m, int i, float out[12])
+{
+    uint32_t b = m->hdr + rd32(m->hdr + HDR_BONE_INDEX) + (uint32_t)i * BONE_SIZE;
+    float p[12];
+    memcpy(p, rt_host(b + 0x60u), sizeof p);
+    if (!finite_n(p, 12)) return 0;
+    for (int r = 0; r < 3; r++) {
+        float len = p[4 * r] * p[4 * r] + p[4 * r + 1] * p[4 * r + 1] + p[4 * r + 2] * p[4 * r + 2];
+        if (fabsf(len - 1.0f) > 0.02f) return 0;
+    }
+    /* Inverse of [R t]: [R^T, -R^T t], rows of four as a matrix3x4_t. */
+    for (int r = 0; r < 3; r++) {
+        for (int c = 0; c < 3; c++) out[4 * r + c] = p[4 * c + r];
+        out[4 * r + 3] = -(p[r] * p[3] + p[4 + r] * p[7] + p[8 + r] * p[11]);
+    }
+    return 1;
+}
+
+/* Per hand, right then left, 16 floats: the hand bone's bind frame (a
+   matrix3x4_t, rows of four, model units), the middle of its palm in
+   the bind pose and a radius the palm's vertices lie within. Bit 0 right,
+   bit 1 left. The palm is halfway from the hand bone to the middle
+   finger's first bone, its radius 0.6 of that distance: vertices there
+   follow the hand bone alone, so they move with it rigidly. */
+int rt_vm_hands_bind(float out[32])
+{
+    memset(out, 0, 32 * sizeof *out);
+    if (!rt_vm_bones_wanted()) return 0;
+    vm_model m;
+    if (!arms_model(&m)) return 0;
+    static const char *const hand_name[2] = {"Bip01 R Hand", "Bip01 L Hand"};
+    static const char *const finger_name[2] = {"Bip01 R Finger2", "Bip01 L Finger2"};
+    int mask = 0;
+    for (int s = 0; s < 2; s++) {
+        int h = bone_named(&m, hand_name[s]), f = bone_named(&m, finger_name[s]);
+        float hb[12], fb[12];
+        if (h < 0 || f < 0 || !bone_bind(&m, h, hb) || !bone_bind(&m, f, fb)) continue;
+        float *o = out + 16 * s;
+        memcpy(o, hb, sizeof hb);
+        float dx = fb[3] - hb[3], dy = fb[7] - hb[7], dz = fb[11] - hb[11];
+        float dist = sqrtf(dx * dx + dy * dy + dz * dz);
+        if (!(dist > 0.5f && dist < 40.0f)) continue;
+        o[12] = hb[3] + 0.5f * dx, o[13] = hb[7] + 0.5f * dy, o[14] = hb[11] + 0.5f * dz;
+        o[15] = 0.6f * dist;
+        mask |= 1 << s;
+    }
+    static int logged = -1;
+    if (mask != logged && env_on("RT_VM_BONES")) {
+        logged = mask;
+        rt_log("vm bones: \"%s\" bind pose: right hand %s, left hand %s; palm radius %.1f and %.1f units", m.model,
+               mask & 1 ? "found" : "not found", mask & 2 ? "found" : "not found", out[15], out[31]);
+    }
+    return mask;
+}
