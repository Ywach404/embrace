+
+/* RT_HANDAIM_POS=0 leaves the gun where the view model holds it and
+   turns it only, to tell a wrong place from a wrong angle on a run. */
+static int place_wanted(void)
+{
+    static int env = -2;
+    if (env == -2) {
+        const char *v = getenv("RT_HANDAIM_POS");
+        env = !(v && *v == '0');
+    }
+    return env;
+}
+
+/* Game units a metre, read as the backend reads it (immersive.m, the
+   same variable and default: the engine's inch), so the gun moves as far
+   in the game as the hand does in the room the eyes are drawn for. */
+static float units_per_m(void)
+{
+    static float upm;
+    if (!upm) {
+        const char *u = getenv("RT_STEREO_UNITS_PER_M");
+        double v = u && *u ? atof(u) : 1.0 / 0.0254;
+        upm = v > 0 ? (float)v : (float)(1.0 / 0.0254);
+    }
+    return upm;
+}
+
+/* RT_HANDAIM_REST="forward,right,up" in game units: the hand's place from
+   the head that leaves the gun where the view model holds it. The model
+   has its own offset from the view's origin built in (low and to the
+   right), so at 0, the default, the model's origin is at the hand and the
+   gun sits that much lower and further right than the hand; a rest of
+   about the hand's place when the gun looks held cancels it. */
+static const float *rest_offset(void)
+{
+    static float rest[3];
+    static int read;
+    if (!read) {
+        read = 1;
+        const char *v = getenv("RT_HANDAIM_REST");
+        float f[3];
+        if (v && sscanf(v, "%f,%f,%f", &f[0], &f[1], &f[2]) == 3) memcpy(rest, f, sizeof rest);
+    }
+    return rest;
+}
+
+static void turn(uint32_t va, const float d[3])
+{
+    float a[3];
+    memcpy(a, rt_host(va), sizeof a);
+    a[0] += d[0];
+    a[1] = (float)rt_headlook_wrap(a[1] + d[1]);
+    memcpy(rt_host(va), a, sizeof a);
+}
+
+/* The view model's pose, made by the game for the view at angp, turned
+   and moved to the hand. Only on the stock path, where the pose starts
+   from the view's own angles (+0x20 is a copy of them): the other one
+   takes another entity's pose and is left as the game made it. */
+static void view_model_to_hand(uint32_t rec, uint32_t angp)
+{
+    uint32_t live = rt_hook_va("client", LIVE_ANGLES_RVA);
+    if (!rec || !angp || !live || !MEM32(live) || !wanted() || !*(const uint8_t *)rt_host(rec)) return;
+    float view[3], still[3];
+    memcpy(view, rt_host(angp), sizeof view);
+    memcpy(still, rt_host(rec + REC_STILL), sizeof still);
+    if (memcmp(view, still, sizeof view)) return;
+    float head_yaw, head_pitch, aim[16];
+    int state = rt_input_hand_aim_pose(&head_yaw, &head_pitch, aim);
+    if (!state) return;
+    tilt_down(aim);
+    /* From zero, not from the view's angles: the offset alone, so the
+       game's pitch limit never eats part of it near straight up or down.
+       The same offset the command gets, so the gun and the shot agree. */
+    static const float zero[3];
+    float d[3];
+    rt_headlook_hand_aim(zero, head_yaw, head_pitch, aim, d);
+    turn(rec + REC_ANGLES, d);
+    turn(rec + REC_STILL, d);
+    /* Position only while the hand's is tracked: at state 1 ARKit gives
+       orientation alone and the translation is stale. */
+    float head[3], off[3] = {0, 0, 0};
+    int placed = state >= 2 && place_wanted() && rt_input_head_position(head);
+    if (placed) {
+        rt_headlook_hand_offset(head, head_yaw, aim, view[1], units_per_m(), rest_offset(), off);
+        float o[3];
+        memcpy(o, rt_host(rec + REC_ORIGIN), sizeof o);
+        for (int i = 0; i < 3; i++) o[i] += off[i];
+        memcpy(rt_host(rec + REC_ORIGIN), o, sizeof o);
+    }
+    static uint32_t s_held;
+    uint32_t n = __atomic_add_fetch(&s_held, 1, __ATOMIC_RELAXED);
+    /* Two models a frame: the first pose and then one in 240, about two
+       seconds, so a run shows how far the gun was turned and moved. */
+    if (n == 1 || n % 240 == 0)
+        rt_log("hand aim view model %u: turned pitch %.1f yaw %.1f, moved %s %.1f %.1f %.1f (state %d)", n, d[0], d[1],
+               placed ? "by" : "not", off[0], off[1], off[2], state);
+}
 #endif
 
+static uint32_t (*s_gcall)(uint32_t, int, const uint32_t *) = rt_guest_call;
+
+/* The game poses the model as it would, through the original call, and
+   the record it returns goes back unchanged in eax. */
+static uint32_t hand_aim_view_model(const uint32_t *a)
+{
+    uint32_t self = g_ecx, args[7];
+    memcpy(args, a, sizeof args);
+    g_ecx = self;
+    uint32_t rec = s_gcall(rt_hook_va("client", VM_POSE_RVA), 7, args);
+#if TARGET_OS_VISION
+    view_model_to_hand(rec, a[3]);
+#endif
+    return rec;
+}
