 runtime/input.h          |  29 +++
 runtime/input_selftest.c | 469 +++++++++++++++++++++++++++++++++------
 runtime/pad.c            | 136 +++++++++---
 runtime/pad.h            |  23 +-
 5 files changed, 845 insertions(+), 111 deletions(-)

diff --git a/runtime/input.c b/runtime/input.c
index a60dbde..885ed84 100644
--- a/runtime/input.c
+++ b/runtime/input.c
@@ -326,6 +326,267 @@ int rt_input_translate(rt_input_state *s, const SDL_Event *e, const rt_present_r
     return n;
 }
 
+/* The dialogue HUD (client CHudDialog) fields the answer highlight uses,
+   from its lifted code: Key_Event (sub_10555260) picks slot 0 to 3 on
+   the release of 1 to 4 through sub_105549F0, which needs idx < count
+   and ignores a pick within 0.5 s of the last (the time is the float at
+   +0x5A80, written only when a pick goes through). The answers are drawn
+   by sub_10553B50 every frame from the slot texts, through
+   Q_snprintf("%d. %s"), so an edit shows on the next frame. History
+   (+0x1B2) draws the past lines instead, and single-line mode (+0x1B3)
+   draws only the last line said; neither shows the answers. */
+#define DIALOGUE_ACTIVE 0x1B4u
+#define DIALOGUE_HISTORY 0x1B2u
+#define DIALOGUE_SINGLE 0x1B3u
+#define DIALOGUE_COUNT 0x1228u
+#define DIALOGUE_TEXT 0x122Cu
+#define DIALOGUE_TYPE 0x322Cu
+#define DIALOGUE_FLAGS 0x323Cu
+#define DIALOGUE_PICK_TIME 0x5A80u
+
+/* Host time since the last pick before a confirm is sent. The game's
+   own guard is 0.5 s on its clock; a pick it makes is seen here a pump
+   late, so the guard here is never shorter than the game's. */
+#define DIALOGUE_GUARD_NS 500000000ull
+/* A count past this is not a dialogue the selector should step through:
+   it is a panel in the middle of being torn down or rebuilt. */
+#define DIALOGUE_COUNT_MAX 64
+#define DIALOGUE_LOG_NS 250000000ull
+
+static uint32_t panel32(uint32_t va)
+{
+    uint32_t v;
+    memcpy(&v, rt_host(va), sizeof v);
+    return v;
+}
+
+static uint8_t panel8(uint32_t va) { return *(const uint8_t *)rt_host(va); }
+
+static char *slot_text(uint32_t va, int i) { return (char *)rt_host(va + DIALOGUE_TEXT + (uint32_t)i * RT_DLG_TEXT); }
+
+static uint32_t text_sum(const char *t)
+{
+    uint32_t h = 2166136261u;
+    for (size_t i = 0; i < RT_DLG_TEXT && t[i]; i++) h = (h ^ (uint8_t)t[i]) * 16777619u;
+    return h;
+}
+
+static int slots_of(int32_t count) { return count < 0 ? 0 : count > RT_DLG_SLOTS ? RT_DLG_SLOTS : (int)count; }
+
+static void sel_log(rt_dialogue_sel *g, uint64_t now)
+{
+    g->log_dirty = 0;
+    g->log_ns = now;
+    if (g->lit) rt_log("dialogue highlight %d of %d", g->idx + 1, g->count);
+}
+
+/* A move logs at once unless the last line was moments ago; a stick
+   held down a long list then logs where it rests, not every step. */
+static void sel_note(rt_dialogue_sel *g, uint64_t now)
+{
+    if (now - g->log_ns >= DIALOGUE_LOG_NS || !g->log_ns) sel_log(g, now);
+    else g->log_dirty = 1;
+}
+
+/* The edit stays ours only while the slot holds exactly what was
+   written. If the game wrote the slot since, its text is the new truth
+   and putting the old one back would clobber it. */
+static int sel_intact(const rt_dialogue_sel *g)
+{
+    return g->idx < RT_DLG_SLOTS && !memcmp(slot_text(g->va, g->idx), g->written, RT_DLG_TEXT);
+}
+
+static void sel_restore(rt_dialogue_sel *g)
+{
+    if (g->lit && g->idx < RT_DLG_SLOTS && sel_intact(g)) memcpy(slot_text(g->va, g->idx), g->saved, RT_DLG_TEXT);
+}
+
+static void sel_drop(rt_dialogue_sel *g, int restore, const char *why)
+{
+    if (!g->lit) return;
+    if (restore) sel_restore(g);
+    g->lit = 0;
+    g->log_dirty = 0;
+    g->resets++;
+    rt_log("dialogue highlight cleared (%s)", why);
+}
+
+/* The game's text is narrow and NUL terminated in a 0x800 buffer, and
+   the draw formats it with "%s", so the prefix goes in front and the
+   tail is cut to fit; the whole block is saved, so the cut is undone on
+   restore. */
+static void sel_write(rt_dialogue_sel *g)
+{
+    char *t = slot_text(g->va, g->idx);
+    memcpy(g->saved, t, RT_DLG_TEXT);
+    memset(g->written, 0, RT_DLG_TEXT);
+    size_t len = strnlen(g->saved, RT_DLG_TEXT - 1);
+    if (len > RT_DLG_TEXT - 3) len = RT_DLG_TEXT - 3;
+    g->written[0] = '>';
+    g->written[1] = ' ';
+    memcpy(g->written + 2, g->saved, len);
+    memcpy(t, g->written, RT_DLG_TEXT);
+}
+
+static void sel_snapshot(rt_dialogue_sel *g)
+{
+    int n = slots_of(g->count);
+    for (int i = 0; i < n; i++) {
+        g->sum[i] = text_sum(i == g->idx ? g->saved : slot_text(g->va, i));
+        g->type[i] = panel32(g->va + DIALOGUE_TYPE + 4u * (uint32_t)i);
+        g->flags[i] = panel32(g->va + DIALOGUE_FLAGS + 4u * (uint32_t)i);
+    }
+}
+
+static void sel_light(rt_dialogue_sel *g, uint32_t va, int32_t count, int idx, uint64_t now)
+{
+    g->lit = 1;
+    g->va = va;
+    g->count = count;
+    g->idx = idx;
+    if (idx < RT_DLG_SLOTS) sel_write(g);
+    sel_snapshot(g);
+    g->steps++;
+    sel_note(g, now);
+}
+
+/* The panel can be stepped: it is the HUD, active, and showing answers. */
+static int sel_ready(uint32_t va)
+{
+    return va && panel8(va + DIALOGUE_ACTIVE) && !panel8(va + DIALOGUE_HISTORY) && !panel8(va + DIALOGUE_SINGLE);
+}
+
+/* Once per pump, before the pad is read, on the game thread: the pump
+   runs between the game's frames, so nothing of the game's writes a slot
+   while it is read or edited here. Anything that changes the answers
+   other than our own edit ends the highlight, so a confirm can never
+   send the number of an answer the player did not see marked. A slot
+   rewritten to the same text it had (the game putting it back on its own
+   schedule) gets the marker again. */
+static void sel_sync(rt_input_state *s, uint64_t now)
+{
+    rt_dialogue_sel *g = &s->sel;
+    uint32_t va = s->dialogue_va;
+    if (va) {
+        uint32_t bits = panel32(va + DIALOGUE_PICK_TIME);
+        if (g->pick_va == va && bits != g->pick_bits) g->pick_ns = now;
+        g->pick_va = va;
+        g->pick_bits = bits;
+    }
+    if (!g->lit) return;
+    /* A HUD that is gone or replaced is never written: the memory may
+       belong to something else now. */
+    if (va != g->va) {
+        sel_drop(g, 0, "the panel went away");
+        return;
+    }
+    if (!panel8(va + DIALOGUE_ACTIVE)) {
+        sel_drop(g, 1, "dialogue closed");
+        return;
+    }
+    if (panel8(va + DIALOGUE_HISTORY)) {
+        sel_drop(g, 1, "history opened");
+        return;
+    }
+    if (panel8(va + DIALOGUE_SINGLE)) {
+        sel_drop(g, 1, "single line");
+        return;
+    }
+    int32_t count = (int32_t)panel32(va + DIALOGUE_COUNT);
+    if (count != g->count) {
+        sel_drop(g, 1, "the answer count changed");
+        return;
+    }
+    int n = slots_of(count), reapply = 0;
+    const char *why = NULL;
+    for (int i = 0; i < n && !why; i++) {
+        const char *t = slot_text(va, i);
+        if (panel32(va + DIALOGUE_TYPE + 4u * (uint32_t)i) != g->type[i] || panel32(va + DIALOGUE_FLAGS + 4u * (uint32_t)i) != g->flags[i])
+            why = "an answer's type changed";
+        else if (i != g->idx && text_sum(t) != g->sum[i])
+            why = "an answer's text changed";
+        else if (i == g->idx && !sel_intact(g))
+            reapply = 1;
+    }
+    if (why) {
+        sel_drop(g, 1, why);
+        return;
+    }
+    if (reapply && strncmp(slot_text(va, g->idx), g->saved, RT_DLG_TEXT)) {
+        sel_drop(g, 0, "the highlighted answer was rewritten");
+        return;
+    }
+    if (reapply) {
+        sel_write(g);
+        g->reapplies++;
+        if (now - g->reapply_log_ns >= 1000000000ull || !g->reapply_log_ns) {
+            g->reapply_log_ns = now;
+            rt_log("dialogue highlight reapplied (the game rewrote the answer; %u so far)", g->reapplies);
+        }
+    }
+    if (g->log_dirty && now - g->log_ns >= DIALOGUE_LOG_NS) sel_log(g, now);
+}
+
+static int key_event(SDL_Event *e, int scancode, int down)
+{
+    memset(e, 0, sizeof *e);
+    e->type = down ? SDL_EVENT_KEY_DOWN : SDL_EVENT_KEY_UP;
+    e->key.scancode = (SDL_Scancode)scancode;
+    e->key.down = down;
+    return 1;
+}
+
+/* What a pad answer action does. Only a confirm sends the game anything:
+   the text goes back first, so the line the game copies into its history
+   on the pick is the answer's own, then the number key is pressed and
+   released together, since the HUD picks on the release. */
+static int sel_act(rt_input_state *s, int act, uint64_t now, SDL_Event *out, int cap)
+{
+    rt_dialogue_sel *g = &s->sel;
+    uint32_t va = s->dialogue_va;
+    switch (act) {
+    case RT_PAD_ACT_UP:
+    case RT_PAD_ACT_DOWN: {
+        if (!sel_ready(va)) return 0;
+        int32_t count = (int32_t)panel32(va + DIALOGUE_COUNT);
+        if (count <= 0 || count > DIALOGUE_COUNT_MAX) return 0;
+        /* The first move marks the first answer whichever way it goes:
+           nothing is marked, so there is no "next" to go to. */
+        int idx = !g->lit ? 0 : g->idx + (act == RT_PAD_ACT_UP ? -1 : 1);
+        if (idx < 0) idx = 0;
+        if (idx > count - 1) idx = count - 1;
+        if (g->lit && idx == g->idx && count == g->count) return 0;
+        sel_restore(g);
+        sel_light(g, va, count, idx, now);
+        return 0;
+    }
+    case RT_PAD_ACT_CLEAR: sel_drop(g, 1, "Circle"); return 0;
+    case RT_PAD_ACT_CONFIRM: {
+        if (!g->lit || cap < 2) return 0;
+        if (g->pick_ns && now - g->pick_ns < DIALOGUE_GUARD_NS) {
+            g->held++;
+            rt_log("dialogue confirm %d of %d held: the game ignores a pick within 0.5 s of the last", g->idx + 1, g->count);
+            return 0;
+        }
+        if (g->idx >= RT_DLG_KEYS) {
+            rt_log("dialogue confirm %d of %d refused: the game takes keys 1 to %d", g->idx + 1, g->count, RT_DLG_KEYS);
+            return 0;
+        }
+        int idx = g->idx, count = g->count;
+        sel_restore(g);
+        g->lit = 0;
+        g->log_dirty = 0;
+        g->confirms++;
+        g->pick_ns = now;
+        rt_log("dialogue confirm %d of %d", idx + 1, count);
+        key_event(&out[0], SDL_SCANCODE_1 + idx, 1);
+        key_event(&out[1], SDL_SCANCODE_1 + idx, 0);
+        return 2;
+    }
+    default: return 0;
+    }
+}
+
 static rt_pad_pt pad_point(const rt_input_state *s, const rt_present_rects *r, float density)
 {
     rt_pad_pt p;
@@ -376,10 +637,21 @@ int rt_input_pad_apply(rt_input_state *s, const SDL_Event *ev, int k, int dx, in
 int rt_input_pad_pump(rt_input_state *s, rt_pad_dev *d, int active, uint64_t now_ns, const rt_present_rects *r, float density,
                       rt_wmsg *out, int cap)
 {
-    SDL_Event ev[RT_PAD_EVENTS];
-    int dx, dy, mode = rt_input_pad_mode(s);
+    SDL_Event ev[RT_PAD_EVENTS], go[RT_PAD_EVENTS + 2];
+    int dx, dy, mode = rt_input_pad_mode(s), n = 0;
+    sel_sync(s, now_ns);
+    d->pad.lit = s->sel.lit;
     int k = rt_pad_poll(d, active, mode, pad_point(s, r, density), now_ns, ev, RT_PAD_EVENTS, &dx, &dy);
-    return rt_input_pad_apply(s, ev, k, dx, dy, mode, r, density, out, cap);
+    /* Answer actions become what the selector sends, in their place in
+       the stream, so a key pressed before a confirm still lands first. */
+    for (int i = 0; i < k; i++) {
+        if (ev[i].type != SDL_EVENT_USER) {
+            if (n < RT_PAD_EVENTS + 2) go[n++] = ev[i];
+            continue;
+        }
+        n += sel_act(s, ev[i].user.code, now_ns, go + n, RT_PAD_EVENTS + 2 - n);
+    }
+    return rt_input_pad_apply(s, go, n, dx, dy, mode, r, density, out, cap);
 }
 
 int rt_input_pad_lost(rt_input_state *s, rt_pad_dev *d, const rt_present_rects *r, float density, rt_wmsg *out, int cap)
@@ -864,30 +1136,25 @@ void rt_input_focus(int on)
    reading as a dialogue. */
 #define DIALOGUE_PTR_RVA 0x3EE138u
 #define DIALOGUE_VTABLE_RVA 0x228FDCu
-#define DIALOGUE_ACTIVE 0x1B4u
-
-static uint32_t guest32(uint32_t va)
-{
-    uint32_t v;
-    memcpy(&v, rt_host(va), sizeof v);
-    return v;
-}
 
-static int dialogue_probe(void)
+/* The HUD's address, or 0 when there is no live one. */
+static uint32_t dialogue_probe(void)
 {
     uint32_t slot = rt_hook_va("client", DIALOGUE_PTR_RVA);
     if (!slot) return 0;
-    uint32_t hud = guest32(slot);
-    if (!hud || guest32(hud) != rt_hook_va("client", DIALOGUE_VTABLE_RVA)) return 0;
-    return *(const uint8_t *)rt_host(hud + DIALOGUE_ACTIVE) != 0;
+    uint32_t hud = panel32(slot);
+    if (!hud || panel32(hud) != rt_hook_va("client", DIALOGUE_VTABLE_RVA)) return 0;
+    return hud;
 }
 
 static void dialogue_update(void)
 {
-    int on = dialogue_probe();
+    uint32_t hud = dialogue_probe();
+    int on = hud && panel8(hud + DIALOGUE_ACTIVE) != 0;
     pthread_mutex_lock(&s_mu);
     int was = S.dialogue;
     S.dialogue = on;
+    S.dialogue_va = hud;
     pthread_mutex_unlock(&s_mu);
     if (on != was) rt_log("dialogue %s", on ? "open" : "closed");
 }
diff --git a/runtime/input.h b/runtime/input.h
