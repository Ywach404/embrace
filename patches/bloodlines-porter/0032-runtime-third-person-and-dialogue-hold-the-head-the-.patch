     in.turn = rt_pad_take_turn(&s_padv.pad);
     uint32_t rc = S.head_recentres + __atomic_load_n(&s_head_host_recentres, __ATOMIC_ACQUIRE);
     in.recentre = rc != s_head_seen_rc;
     s_head_seen_rc = rc;
     pthread_mutex_unlock(&s_mu);
-    int was_on = s_head.on, was_playing = s_head.playing, was_pitch = s_head.pitch_only;
-    uint32_t was_rc = s_head.recentres, was_abs = s_head.absorbed;
