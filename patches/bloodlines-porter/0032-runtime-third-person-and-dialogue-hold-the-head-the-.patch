     hl_step(&h, &in, game);
-    check(near_deg(game[1], 80, 1e-3) && h.pose_yaw == 40, "third person: the reference stays where third person began",
-          "yaw %.3f pose %.3f", game[1], h.pose_yaw);
-    in.head_yaw = -20;
-    hl_step(&h, &in, game);
-    in.pitch_only = 0;
-    hl_step(&h, &in, game);
-    check(near_deg(game[1], 20, 1e-3) && h.pose_yaw == -20,
-          "back to first person the head's offset from the reference turns the view, so the world holds still",
