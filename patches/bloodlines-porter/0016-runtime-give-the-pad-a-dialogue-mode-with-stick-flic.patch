+/* Which flick the right stick holds, as a button index or -1. The axis
+   that is further out wins, a held flick lets go only when its own axis
+   comes back under the release mark, and after entering a dialogue
+   nothing fires until the stick has been back to the centre: a player
+   looking around as the dialogue opens must not pick an answer. */
+static int flick_of(rt_pad *p)
+{
+    int ax = abs(p->rx), ay = abs(p->ry);
+    if (ax <= RT_PAD_FLICK_OFF && ay <= RT_PAD_FLICK_OFF) p->flick_armed = 1;
+    if (p->flick >= 0) {
+        int v = p->flick == RT_PAD_FLICK_UP ? -p->ry : p->flick == RT_PAD_FLICK_DOWN ? p->ry : p->flick == RT_PAD_FLICK_LEFT ? -p->rx : p->rx;
+        if (v > RT_PAD_FLICK_OFF) return p->flick;
+    }
+    if (!p->flick_armed) return -1;
+    if (ay >= ax && ay > RT_PAD_FLICK_ON) return p->ry < 0 ? RT_PAD_FLICK_UP : RT_PAD_FLICK_DOWN;
+    if (ax > ay && ax > RT_PAD_FLICK_ON) return p->rx < 0 ? RT_PAD_FLICK_LEFT : RT_PAD_FLICK_RIGHT;
+    return -1;
+}
+
+/* One press per flick and no repeat: the game picks on the key's
+   release, so a held stick picks once, and a second answer needs the
+   stick to come back first. Called once both axes are read, so a
+   diagonal is judged whole rather than by whichever axis came first. */
+int rt_pad_flick(rt_pad *p, rt_pad_pt pt, SDL_Event *out, int cap)
+{
+    int f = p->mode == RT_PAD_DIALOGUE ? flick_of(p) : -1, n = 0;
+    if (f == p->flick) return 0;
+    if (p->flick >= 0) n += rt_pad_button(p, p->flick, 0, pt, out, cap);
+    p->flick = f;
+    if (f >= 0) {
+        p->flick_armed = 0;
+        n += rt_pad_button(p, f, 1, pt, out + n, cap - n);
+    }
+    return n;
+}
