+    check(rt_input_menu(&s) && d.pad.menu == RT_PAD_MENU && s_n == 0, "a shown cursor is menu mode", "menu %d %s", d.pad.menu, dump());
+    pad_map_mode(&s, &d, id, 1);
+    check((d.pad.logged[RT_PAD_MENU] & 1u) && !(d.pad.logged[RT_PAD_PLAY] & 1u), "a press is logged once for its mode", "%X %X",
+          d.pad.logged[RT_PAD_MENU], d.pad.logged[RT_PAD_PLAY]);
+
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    s_n = 0;
+    padpump(&s, &d, 10);
+    check(!rt_input_menu(&s) && d.pad.menu == RT_PAD_PLAY && s_n == 0, "a hidden cursor is play mode", "menu %d %s", d.pad.menu, dump());
+    pad_map_mode(&s, &d, id, 0);
+
+    /* Across a mode change a release sends what its press sent. */
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_SOUTH, 1);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTX, 32767);
+    padpump(&s, &d, 10);
+    check(s_n == 2 && s_m[0].wp == 0x20 && s_m[1].wp == 0x44, "play: Cross holds space and the left stick holds D", "%s", dump());
+    s_n = 0;
+    s.cursor = 0x00007F00u;
+    rt_input_relative_update(&s);
+    int32_t x0 = s.x;
+    padpump(&s, &d, 10);
+    check(s_n == 1 && s_m[0].msg == WM_KEYUP && s_m[0].wp == 0x44, "opening a menu lifts the left stick's movement key", "%s", dump());
+    s_n = 0;
+    rt_pad_test_button(id, SDL_GAMEPAD_BUTTON_SOUTH, 0);
+    padpump(&s, &d, 10);
+    /* The cursor move the left stick made is flushed ahead of the key. */
+    int k0 = s_n == 2 && s_m[0].msg == WM_MOUSEMOVE;
+    check((s_n == 1 || k0) && s_m[k0].msg == WM_KEYUP && s_m[k0].wp == 0x20, "Cross pressed in play releases as space in a menu, not a click",
+          "%s", dump());
+    check(s.x > x0, "in a menu the left stick moves the cursor", "%d -> %d", x0, s.x);
+    s_n = 0;
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(s_n == 0, "in a menu the left stick holds no keys", "%s", dump());
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    padpump(&s, &d, 10);
+
+    /* The cursor moves in client pixels and clamps to the client. */
+    s.x = 1270;
+    s.y = 512;
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHTX, 32767);
+    for (int i = 0; i < 10; i++) padpump(&s, &d, 10);
+    check(s.x == 1279 && s.y == 512, "the menu cursor stops at the client's edge", "%d,%d", s.x, s.y);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHTX, 0);
+    padpump(&s, &d, 10);
+    check(s.warp_pending, "a pad cursor move asks for a warp so the host pointer follows", "%d", s.warp_pending);
+
+    /* Frame rate independence: the same stick for the same real time
+       moves the cursor the same distance at 30, 60, 90 and 120 Hz. */
+    static const int k_hz[] = {30, 60, 90, 120};
+    double dz = RT_PAD_CURSOR_DEAD / 32767.0;
+    int half = (int)lround((dz + 0.5 * (1 - dz)) * 32767);
+    double want = RT_PAD_CURSOR_SPEED * pow(0.5, RT_PAD_CURSOR_POWER);
+    for (int axis = 0; axis < 2; axis++) {
+        for (size_t h = 0; h < sizeof k_hz / sizeof *k_hz; h++) {
+            int stick = axis ? SDL_GAMEPAD_AXIS_LEFTX : SDL_GAMEPAD_AXIS_RIGHTX;
+            s.x = 100;
+            s.y = 512;
+            rt_pad_test_axis(id, stick, half);
+            uint64_t step = 1000000000ull / (uint64_t)k_hz[h];
+            for (int f = 0; f < k_hz[h]; f++) padpump_ns(&s, &d, step);
+            rt_pad_test_axis(id, stick, 0);
+            padpump(&s, &d, 10);
+            double got = s.x - 100, w = axis ? want * RT_PAD_CURSOR_LEFT : want;
+            char name[96];
+            snprintf(name, sizeof name, "%s stick half tilt for 1 s at %d Hz moves %.0f px", axis ? "left" : "right", k_hz[h], w);
+            check(fabs(got - w) <= 2.0, name, "moved %.0f", got);
+        }
+    }
+    rt_pad_test_detach(id);
+    padpump(&s, &d, 10);
+}
+
+static void pad_curve(void)
+{
+    rt_pad p;
+    rt_pad_defaults(&p);
+    double vx, vy, dz = p.cursor_dead / 32767.0;
+    rt_pad_cursor_velocity(&p, 0, 0, &vx, &vy);
+    check(vx == 0 && vy == 0, "cursor at rest is still", "%f %f", vx, vy);
+    rt_pad_cursor_velocity(&p, p.cursor_dead, 0, &vx, &vy);
+    check(vx == 0, "cursor inside its dead zone is still", "%f", vx);
+    static const double k_d[] = {0.05, 0.1, 0.25, 0.5, 0.75, 1.0};
+    double last = 0;
+    for (size_t i = 0; i < sizeof k_d / sizeof *k_d; i++) {
+        int v = (int)lround((dz + k_d[i] * (1 - dz)) * 32767);
+        rt_pad_cursor_velocity(&p, v, 0, &vx, &vy);
+        double w = p.cursor_speed * pow(k_d[i], p.cursor_power);
+        char name[96];
+        snprintf(name, sizeof name, "cursor at %.0f%% past the dead zone runs %.1f px/s", k_d[i] * 100, w);
+        check(fabs(vx - w) <= w * 0.01 + 0.5 && vx > last && vy == 0, name, "%f", vx);
+        last = vx;
+        rt_pad_cursor_velocity(&p, -v, 0, &vx, &vy);
+        snprintf(name, sizeof name, "cursor at %.0f%% to the left mirrors it", k_d[i] * 100);
+        check(fabs(vx + w) <= w * 0.01 + 0.5, name, "%f", vx);
+    }
+    rt_pad_cursor_velocity(&p, 23170, 23170, &vx, &vy);
+    check(fabs(hypot(vx, vy) - p.cursor_speed) < 2 && fabs(vx - vy) < 1e-9, "a full diagonal runs at full speed along it", "%f %f", vx, vy);
+    rt_pad_cursor_velocity(&p, 32767, 0, &vx, &vy);
