 {
     s_mode = mode;
     snprintf(s_overlay, sizeof s_overlay, "%s", overlay);
-    rt_d3d9_bridge_shims[0].kind = mode == RT_GFX_DXVK ? RT_SHIM_BRIDGE : RT_SHIM_REAL;
+    rt_d3d9_bridge_shims[0].kind = mode != RT_GFX_NULL ? RT_SHIM_BRIDGE : RT_SHIM_REAL;
+    if (mode == RT_GFX_METAL) return metal_init(overlay);
     if (mode != RT_GFX_DXVK) {
         rt_log("gfx null");
         return 0;
