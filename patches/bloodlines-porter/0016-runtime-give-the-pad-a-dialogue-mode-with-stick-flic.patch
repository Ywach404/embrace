 /* The game shows its cursor exactly when a screen of its own is up:
-   menus, dialogue, the inventory and the character sheet. The pad's
-   menu mode and the host's cursor ring both key off this one test. */
+   menus, the inventory and the character sheet. Not dialogue: its HUD
+   keeps the cursor hidden and the pointer relative (imm3 device log),
+   and takes only number keys. The pad's menu mode and the host's cursor
+   ring both key off this one test. */
 int rt_input_menu(const rt_input_state *s) { return s->focus && guest_shape(s) != RT_CUR_HIDDEN; }
 
+/* A shown cursor wins: a menu opened over a dialogue (Escape) is worked
+   with the cursor, and the dialogue's flicks come back when it closes. */
+int rt_input_pad_mode(const rt_input_state *s)
+{
+    if (rt_input_menu(s)) return RT_PAD_MENU;
+    return s->focus && s->dialogue ? RT_PAD_DIALOGUE : RT_PAD_PLAY;
+}
+
 int rt_input_relative_wanted(const rt_input_state *s)
 {
     return s->focus && s->host_focus && guest_shape(s) == RT_CUR_HIDDEN;
@@ -844,6 +854,44 @@ void rt_input_focus(int on)
     post_all(m, n, RT_KEYIDX + 8);
 }
 
+/* The dialogue HUD (client CHudDialog) stores itself at client+0x3EE138
+   when constructed, and its active flag at +0x1B4 is written only by its
+   SetActive, which the server's DialogCtrl message drives, and by its
+   Init at level start; the game's own IsDialogActive reads the same
+   pair. Reading it each pump is exact where the cursor, the font binding
+   and relative mode are not: none of them change in a dialogue. The
+   vtable check keeps a pointer left behind by a torn down HUD from
+   reading as a dialogue. */
+#define DIALOGUE_PTR_RVA 0x3EE138u
+#define DIALOGUE_VTABLE_RVA 0x228FDCu
+#define DIALOGUE_ACTIVE 0x1B4u
+
+static uint32_t guest32(uint32_t va)
+{
+    uint32_t v;
+    memcpy(&v, rt_host(va), sizeof v);
+    return v;
+}
+
+static int dialogue_probe(void)
+{
+    uint32_t slot = rt_hook_va("client", DIALOGUE_PTR_RVA);
+    if (!slot) return 0;
+    uint32_t hud = guest32(slot);
+    if (!hud || guest32(hud) != rt_hook_va("client", DIALOGUE_VTABLE_RVA)) return 0;
+    return *(const uint8_t *)rt_host(hud + DIALOGUE_ACTIVE) != 0;
+}
+
+static void dialogue_update(void)
+{
+    int on = dialogue_probe();
+    pthread_mutex_lock(&s_mu);
+    int was = S.dialogue;
+    S.dialogue = on;
+    pthread_mutex_unlock(&s_mu);
+    if (on != was) rt_log("dialogue %s", on ? "open" : "closed");
+}
+
 static void pad_pump(void)
 {
     rt_present_rects r;
@@ -860,6 +908,7 @@ void rt_input_pump_end(void)
 {
     rt_toggles_apply();
     if (!s_win) return;
+    dialogue_update();
     if (s_pad_started) pad_pump();
     rt_wmsg m[1];
     int warp = 0, shape, rel_changed;
