+static void padpump_ns(rt_input_state *s, rt_pad_dev *d, uint64_t ns)
+{
+    s_pad_t += ns;
+    s_n += rt_input_pad_pump(s, d, s->focus, s_pad_t, &R1, 1.0f, s_m + s_n, 256 - s_n);
+}
+
+/* SDL button, or -1 with the trigger axis; then what menu and play send:
+   the message and, for keys and clicks, its wparam (0 skips it). */
+static const struct {
+    int btn, axis;
+    const char *name;
+    uint32_t menu_msg, menu_wp, play_msg, play_wp;
+} k_padmap[] = {
+    {SDL_GAMEPAD_BUTTON_SOUTH, -1, "Cross", WM_LBUTTONDOWN, 1, WM_KEYDOWN, 0x20},
+    {SDL_GAMEPAD_BUTTON_EAST, -1, "Circle", WM_KEYDOWN, 0x1B, WM_KEYDOWN, 0x45},
+    {SDL_GAMEPAD_BUTTON_WEST, -1, "Square", WM_KEYDOWN, 0x49, WM_KEYDOWN, 0x49},
+    {SDL_GAMEPAD_BUTTON_NORTH, -1, "Triangle", WM_KEYDOWN, 0x46, WM_KEYDOWN, 0x46},
+    {SDL_GAMEPAD_BUTTON_BACK, -1, "Create", WM_KEYDOWN, 0x43, WM_KEYDOWN, 0x43},
+    {SDL_GAMEPAD_BUTTON_START, -1, "Options", WM_KEYDOWN, 0x1B, WM_KEYDOWN, 0x1B},
+    {SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, -1, "L1", WM_MOUSEWHEEL, 0, WM_MOUSEWHEEL, 0},
+    {SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, -1, "R1", WM_MOUSEWHEEL, 0, WM_MOUSEWHEEL, 0},
+    {SDL_GAMEPAD_BUTTON_LEFT_STICK, -1, "L3", WM_KEYDOWN, 0x4C, WM_KEYDOWN, 0x4C},
+    {SDL_GAMEPAD_BUTTON_RIGHT_STICK, -1, "R3", WM_KEYDOWN, 0x11, WM_KEYDOWN, 0x11},
+    {SDL_GAMEPAD_BUTTON_DPAD_UP, -1, "d-pad up", WM_KEYDOWN, 0x31, WM_KEYDOWN, 0x31},
+    {SDL_GAMEPAD_BUTTON_DPAD_DOWN, -1, "d-pad down", WM_KEYDOWN, 0x33, WM_KEYDOWN, 0x33},
+    {SDL_GAMEPAD_BUTTON_DPAD_LEFT, -1, "d-pad left", WM_KEYDOWN, 0x34, WM_KEYDOWN, 0x34},
+    {SDL_GAMEPAD_BUTTON_DPAD_RIGHT, -1, "d-pad right", WM_KEYDOWN, 0x32, WM_KEYDOWN, 0x32},
+    {SDL_GAMEPAD_BUTTON_TOUCHPAD, -1, "touchpad", WM_KEYDOWN, 0x52, WM_KEYDOWN, 0x52},
+    {SDL_GAMEPAD_BUTTON_MISC1, -1, "share", WM_KEYDOWN, 0x52, WM_KEYDOWN, 0x52},
+    {-1, SDL_GAMEPAD_AXIS_LEFT_TRIGGER, "L2", WM_RBUTTONDOWN, 2, WM_RBUTTONDOWN, 2},
+    {-1, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, "R2", WM_LBUTTONDOWN, 1, WM_LBUTTONDOWN, 1},
+};
+
+static void press(SDL_JoystickID id, int i, int down)
+{
+    if (k_padmap[i].btn >= 0) rt_pad_test_button(id, k_padmap[i].btn, down);
+    else rt_pad_test_axis(id, k_padmap[i].axis, down ? 32767 : 0);
+}
+
+static void pad_map_mode(rt_input_state *s, rt_pad_dev *d, SDL_JoystickID id, int menu)
+{
+    char name[96];
+    for (size_t i = 0; i < sizeof k_padmap / sizeof *k_padmap; i++) {
+        uint32_t msg = menu ? k_padmap[i].menu_msg : k_padmap[i].play_msg;
+        uint32_t wp = menu ? k_padmap[i].menu_wp : k_padmap[i].play_wp;
+        s_n = 0;
+        press(id, (int)i, 1);
+        padpump(s, d, 10);
+        snprintf(name, sizeof name, "%s %s press", menu ? "menu" : "play", k_padmap[i].name);
+        /* Escape also gives its WM_CHAR, so only the first message is held to. */
+        check(s_n >= 1 && s_n <= 2 && s_m[0].msg == msg && (msg == WM_MOUSEWHEEL || s_m[0].wp == wp), name, "%s", dump());
+        s_n = 0;
+        press(id, (int)i, 0);
+        padpump(s, d, 10);
+        snprintf(name, sizeof name, "%s %s release", menu ? "menu" : "play", k_padmap[i].name);
+        check(msg == WM_MOUSEWHEEL ? s_n == 0 : s_n == 1 && s_m[0].msg == msg + 1 && (s_m[0].wp == wp || msg != WM_KEYDOWN), name, "%s",
+              dump());
+    }
+}
