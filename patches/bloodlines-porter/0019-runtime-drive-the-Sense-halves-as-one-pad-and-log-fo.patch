 static void padpump_ns(rt_input_state *s, rt_pad_dev *d, uint64_t ns)
 {
     s_pad_t += ns;
@@ -1978,6 +2213,7 @@ int rt_input_selftest(void)
     waitmap();
     pad_detect();
     pad_drive();
+    pad_halves();
     pad_curve();
     pad_modes();
     /* The answer highlight works on a fake HUD in guest memory, so this
diff --git a/runtime/pad.c b/runtime/pad.c
index 84c1f30..f43c191 100644
--- a/runtime/pad.c
+++ b/runtime/pad.c
@@ -97,6 +97,23 @@ int rt_pad_detect(SDL_GamepadType type, const char *name)
     return RT_PAD_XBOX;
 }
 
+/* By name, since SDL has no type for the halves: GameController names
+   them by vendor ("PlayStation VR2 Sense Controller (L)"), and the
+   product category ("Left Spatial Controller") is what SDL falls back on
+   when a controller has no vendor name. */
+int rt_pad_half(const char *name)
+{
+    if (!name) return RT_PAD_WHOLE;
+    if (strcasestr(name, "Left Spatial Controller")) return RT_PAD_HALF_L;
+    if (strcasestr(name, "Right Spatial Controller")) return RT_PAD_HALF_R;
+    if (!strcasestr(name, "Sense Controller") && !strcasestr(name, "Spatial Controller")) return RT_PAD_WHOLE;
+    size_t n = strlen(name);
+    if (n >= 5 && !strcasecmp(name + n - 5, "(L/R)")) return RT_PAD_PAIR;
+    if (n >= 3 && !strcasecmp(name + n - 3, "(L)")) return RT_PAD_HALF_L;
+    if (n >= 3 && !strcasecmp(name + n - 3, "(R)")) return RT_PAD_HALF_R;
+    return RT_PAD_WHOLE;
+}
+
 int rt_pad_kind(void) { return atomic_load(&s_detected); }
 
 const char *rt_pad_type_name(int kind) { return kind == RT_PAD_PLAYSTATION ? "playstation" : "xbox"; }
@@ -654,11 +671,38 @@ static int slot_of(const rt_pad_dev *d, SDL_JoystickID id)
     return -1;
 }
 
+static int is_half(int half) { return half == RT_PAD_HALF_L || half == RT_PAD_HALF_R; }
+
+/* Two open slots drive as one when they are the same slot or both
+   halves. Any (L) and (R) count as one pad: there is one Sense pair to a
+   headset. */
+static int grouped(const rt_pad_dev *d, int i, int j)
+{
+    return i == j || (is_half(d->slot[i].half) && is_half(d->slot[j].half));
+}
+
+static int pair_slot(const rt_pad_dev *d)
+{
+    for (int i = 0; i < d->nslots; i++)
+        if (d->slot[i].half == RT_PAD_PAIR) return i;
+    return -1;
+}
+
+/* The joystick's own name, not the gamepad's: SDL can name a gamepad
+   after a mapping it shares with another device, and the two halves
+   differ only in their names. */
+static const char *slot_name(const rt_pad_dev *d, int i)
+{
+    const char *nm = SDL_GetJoystickName(SDL_GetGamepadJoystick(d->slot[i].gp));
+    return nm ? nm : "?";
+}
+
 /* What a pad is doing, one bit per button (the triggers at their click
    point) and one per stick direction past the dead zone. A pad takes
    over on a bit that newly sets, not on bits that stay set, so a
    resting stick that drifts past the dead zone cannot steal the drive
-   back. */
+   back. Each half keeps its own bits; a fresh bit on either takes the
+   drive for both. */
 static uint32_t live(SDL_Gamepad *gp)
 {
     uint32_t b = 0;
@@ -674,18 +718,61 @@ static uint32_t live(SDL_Gamepad *gp)
     return b;
 }
 
+/* The driving pad's input, merged over its group. A lone half reports
+   nothing for the side it does not have, so a button is down when either
+   half holds it and an axis is the one further out: the left stick, L1,
+   L2 and L3 come from (L) and the right side from (R) without naming
+   which SDL button each half's face buttons land on. */
+static int group_button(const rt_pad_dev *d, int drv, SDL_GamepadButton b)
+{
+    for (int i = 0; i < d->nslots; i++)
+        if (grouped(d, i, drv) && SDL_GetGamepadButton(d->slot[i].gp, b)) return 1;
+    return 0;
+}
+
+static int group_axis(const rt_pad_dev *d, int drv, SDL_GamepadAxis a)
+{
+    int best = 0;
+    for (int i = 0; i < d->nslots; i++) {
+        if (!grouped(d, i, drv)) continue;
+        int v = SDL_GetGamepadAxis(d->slot[i].gp, a);
+        if (abs(v) > abs(best)) best = v;
+    }
+    return best;
+}
+
 static void drive(rt_pad_dev *d, int i, const char *why)
 {
     d->gp = d->slot[i].gp;
     d->id = d->slot[i].id;
-    const char *nm = SDL_GetGamepadName(d->gp);
+    const char *nm = slot_name(d, i);
     atomic_store(&s_detected, rt_pad_detect(SDL_GetGamepadType(d->gp), nm));
-    rt_log("pad drives %s type=%s (%s)", nm ? nm : "?", rt_pad_type_name(rt_pad_kind()), why);
+    char all[256] = "";
+    size_t at = 0;
+    for (int j = 0; j < d->nslots && at < sizeof all; j++)
+        if (grouped(d, i, j) && j != i) at += (size_t)snprintf(all + at, sizeof all - at, " with %s", slot_name(d, j));
+    rt_log("pad drives %s%s type=%s (%s)", nm, all, rt_pad_type_name(rt_pad_kind()), why);
+}
