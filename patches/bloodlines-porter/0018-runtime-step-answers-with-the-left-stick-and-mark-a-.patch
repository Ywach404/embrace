+/* What the answers are, as one number: a set seen again under the same
+   key is the same set, so a lone answer Circle cleared stays cleared.
+   Read only while nothing is marked, so the key is over the game's own
+   text. */
+static uint32_t set_key(uint32_t va, int32_t count)
+{
+    uint32_t h = (2166136261u ^ va) * 16777619u;
+    h = (h ^ (uint32_t)count) * 16777619u;
+    for (int i = 0; i < slots_of(count); i++) {
+        h = (h ^ text_sum(slot_text(va, i))) * 16777619u;
+        h = (h ^ panel32(va + DIALOGUE_TYPE + 4u * (uint32_t)i)) * 16777619u;
+        h = (h ^ panel32(va + DIALOGUE_FLAGS + 4u * (uint32_t)i)) * 16777619u;
+    }
+    return h;
+}
