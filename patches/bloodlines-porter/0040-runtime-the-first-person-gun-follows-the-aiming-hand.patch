+
+void rt_headlook_hand_offset(const float head_pos[3], float head_yaw, const float aim[16], float game_yaw, float units_per_m,
+                             const float rest[3], float out[3])
+{
+    const double rad = 0.017453292519943295;
+    double dx = aim[12] - head_pos[0], dy = aim[13] - head_pos[1], dz = aim[14] - head_pos[2];
+    /* Into the head's level frame: ahead along the head's heading,
+       whatever its pitch, so looking down at the gun does not swing it
+       up and out of view. ARKit's yaw is positive left from -Z, so the
+       head's forward is (-sin, 0, -cos) and its right (cos, 0, -sin). */
+    double hs = sin(head_yaw * rad), hc = cos(head_yaw * rad);
+    double fwd = -dx * hs - dz * hc, right = dx * hc - dz * hs, up = dy;
+    fwd = fwd * units_per_m - rest[0];
+    right = right * units_per_m - rest[1];
+    up = up * units_per_m - rest[2];
+    /* The game's view yaw stands for the same heading (head look wrote
+       it), so the same offset turned by it is the hand's in the game's
+       world: forward (cos, sin, 0) and left (-sin, cos, 0) at yaw
+       positive left, and the head's right is the game's minus left. */
+    double gs = sin(game_yaw * rad), gc = cos(game_yaw * rad), left = -right;
+    out[0] = (float)(fwd * gc - left * gs);
+    out[1] = (float)(fwd * gs + left * gc);
+    out[2] = (float)up;
+}
