From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "A.Cervantez" <155030226+Ywach404@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:14:06 -0600
Subject: [PATCH] runtime: third person and dialogue hold the head, the stick
 looks

Third person and a dialogue no longer let the head drive the camera.
The head writes nothing, the right stick looks with yaw and pitch in
third person, a dialogue's close up is the game's own, and the frame
is drawn for a reference fixed when the hold began, so in full view the
world holds still in the room. A head driven camera there was
disorientating on headset runs (2026-11-20 and 2026-11-21).

Looking up and down read as inverted in dialogue: the game re-aims the
view every frame there (32 turns of its own in one run), and only yaw
was compared, so the frame was recorded with the head's pitch over a
pitch the game had set. The eyes then undid a tilt the image never had
and the world moved with the head. A pitch the game set since the last
write is now kept and recorded for that frame.
---
 runtime/headlook.c       |  58 +++++++++++++++-------
 runtime/headlook.h       |  21 +++++---
 runtime/input.c          |  54 ++++++++++++---------
 runtime/input.h          |   8 +--
 runtime/input_selftest.c | 102 +++++++++++++++++++++++++++------------
 5 files changed, 159 insertions(+), 84 deletions(-)

diff --git a/runtime/headlook.c b/runtime/headlook.c
index cd02742..922734f 100644
--- a/runtime/headlook.c
+++ b/runtime/headlook.c
@@ -45,12 +45,49 @@ int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3])
         h->body = in->game[1];
         h->wrote = 0;
     }
+    if (in->hold) {
+        /* The head drives nothing: the game's angles stand, turned by the
+           stick or by the game. On the way in the head's facing becomes
+           the reference, and the frames are drawn for it and for the
+           pitch the game held then, so the world holds still in the room
+           while the head looks across it. The body follows the game's yaw
+           and written[] what the game holds, so on the way back the head's
+           offset from the reference turns the view and nothing jumps. */
+        if (!h->holding) {
+            h->ref = in->head_yaw;
+            h->hold_pitch = -in->game[0];
+            h->holds++;
+        }
+        h->holding = 1;
+        h->body = rt_headlook_wrap(in->game[1]);
+        h->written[0] = in->game[0];
+        h->written[1] = in->game[1];
+        h->wrote = 1;
+        h->pose_valid = 1;
+        h->pose_yaw = (float)h->ref;
+        h->pose_pitch = h->hold_pitch;
+        return 0;
+    }
+    h->holding = 0;
+    /* What the game did to the angles since the last write: a turn of the
+       yaw is taken into the body, so it stands and the head turns on from
+       there. A change of pitch means the game steered it (a scripted look,
+       a recoil): the frame is drawn with the game's pitch, so that is the
+       one written and recorded this frame. Recording the head's pitch over
+       a pitch the game set made the eyes undo a tilt the image never had,
+       and looking up moved the world up with the head (2026-11-21 headset
+       run, a dialogue re-aiming each frame). */
+    int pitch_game = 0;
     if (h->wrote) {
         double d = rt_headlook_diff(h->written[1], in->game[1]);
         if (fabs(d) > RT_HEADLOOK_EPS_DEG) {
             h->body += d;
             h->absorbed++;
         }
+        if (fabs(in->game[0] - h->written[0]) > RT_HEADLOOK_EPS_DEG) {
+            pitch_game = 1;
+            h->pitch_taken++;
+        }
     }
     h->body = rt_headlook_wrap(h->body + in->turn);
     double head = rt_headlook_diff(h->ref, in->head_yaw);
@@ -62,24 +99,9 @@ int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3])
         head = 0;
         h->recentres++;
     }
-    if (in->pitch_only) {
-        /* On the way in the body takes the view's heading and the head's
-           facing then becomes the reference, so the view's yaw holds where
-           it was. After that the head's yaw adds nothing to the view, and
-           the reference stays put: the frame is drawn for it, so in full
-           view the world holds still in the room while the head looks
-           across it. On the way back to full head look the head's offset
-           from the reference turns the view, which keeps the world still. */
-        if (!h->pitch_only) {
-            h->body = rt_headlook_wrap(h->body + head);
-            h->ref = in->head_yaw;
-        }
-        head = 0;
-        h->pitch_only_steps++;
-    }
-    h->pitch_only = in->pitch_only != 0;
     float yaw = (float)rt_headlook_wrap(h->body + head);
-    float pitch = -in->head_pitch;
+    /* ARKit's pitch is up positive, the game's down positive. */
+    float pitch = pitch_game ? in->game[0] : -in->head_pitch;
     if (pitch > h->pitch_down || pitch < -h->pitch_up) {
         pitch = pitch > h->pitch_down ? h->pitch_down : -h->pitch_up;
         h->clamps++;
@@ -95,7 +117,7 @@ int rt_headlook_step(rt_headlook *h, const rt_headlook_in *in, float out[3])
        written: past a limit the image stays at the limit, and the late
        rotation then shows it there rather than where the head is. */
     h->pose_valid = 1;
-    h->pose_yaw = h->pitch_only ? h->ref : in->head_yaw;
+    h->pose_yaw = in->head_yaw;
     h->pose_pitch = -pitch;
     return 1;
 }
