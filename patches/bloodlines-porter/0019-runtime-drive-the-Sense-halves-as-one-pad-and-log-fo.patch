diff --git a/runtime/input_selftest.c b/runtime/input_selftest.c
index 7b1fecd..7961aae 100644
--- a/runtime/input_selftest.c
+++ b/runtime/input_selftest.c
@@ -954,6 +954,241 @@ static void pad_drive(void)
     rt_pad_test_detach(id3);
 }
 
+#define SENSE_L "PlayStation VR2 Sense Controller (L)"
+#define SENSE_R "PlayStation VR2 Sense Controller (R)"
+#define SENSE_LR "PlayStation VR2 Sense Controllers (L/R)"
+
+static int has_msg(uint32_t msg, uint32_t wp)
+{
+    for (int i = 0; i < s_n; i++)
+        if (s_m[i].msg == msg && (!wp || s_m[i].wp == wp)) return 1;
+    return 0;
+}
+
+static int pair_open(const rt_pad_dev *d)
+{
+    for (int i = 0; i < d->nslots; i++)
+        if (d->slot[i].half == RT_PAD_PAIR) return 1;
+    return 0;
+}
+
+static void play_state(rt_input_state *s, rt_pad_dev *d)
+{
+    st(s);
+    s->cursor = 0;
+    s->x = 640;
+    s->y = 512;
+    rt_input_relative_update(s);
+    rt_pad_dev_init(d, NULL);
+}
+
+/* The Sense halves as GameController presents them when they connect one
+   at a time: each its own pad, the left stick and L side on (L), the
+   right stick, Cross and R2 on (R). Each half is only ever given the
+   inputs it has. */
+static void pad_halves(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    static const struct {
+        const char *name;
+        int want;
+    } k_names[] = {
+        {SENSE_L, RT_PAD_HALF_L},
+        {SENSE_R, RT_PAD_HALF_R},
+        {SENSE_LR, RT_PAD_PAIR},
+        {"Left Spatial Controller", RT_PAD_HALF_L},
+        {"Right Spatial Controller", RT_PAD_HALF_R},
+        {"DualSense Wireless Controller", RT_PAD_WHOLE},
+        {"Joy-Con (L)", RT_PAD_WHOLE},
+        {NULL, RT_PAD_WHOLE},
+    };
+    for (size_t i = 0; i < sizeof k_names / sizeof *k_names; i++)
+        check(rt_pad_half(k_names[i].name) == k_names[i].want, "Sense half names", "case %zu gave %d", i, rt_pad_half(k_names[i].name));
+
+    /* L, then R. */
+    play_state(&s, &d);
+    SDL_JoystickID l = rt_pad_test_attach(SENSE_L);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == l && d.nslots == 1 && rt_pad_kind() == RT_PAD_PLAYSTATION, "a lone left half drives as a PlayStation pad",
+          "%s id %u slots %d kind %d", dump(), (unsigned)d.id, d.nslots, rt_pad_kind());
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 32767);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_KEYDOWN, 0x44, 1), "the left half alone walks", "%s", dump());
+    s_n = 0;
+    SDL_JoystickID r = rt_pad_test_attach(SENSE_R);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.nslots == 2 && d.id == l && rt_pad_kind() == RT_PAD_PLAYSTATION,
+          "the right half joining the left releases nothing and takes no drive", "%s slots %d", dump(), d.nslots);
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 20000);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_LBUTTONDOWN, 1, 1), "R2 on the right half fires while the left half walks", "%s", dump());
+    s_n = 0;
+    rt_pad_test_button(r, SDL_GAMEPAD_BUTTON_SOUTH, 1);
+    rt_pad_test_button(l, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 2 && has_msg(WM_KEYDOWN, 0x20) && has_msg(WM_MOUSEWHEEL, 0), "Cross from the right and L1 from the left in one pump",
+          "%s", dump());
+    rt_pad_test_button(r, SDL_GAMEPAD_BUTTON_SOUTH, 0);
+    rt_pad_test_button(l, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, 0);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    s.x = 640;
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHTX, 32767);
+    for (int i = 0; i < 10; i++) padpump(&s, &d, 10);
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHTX, 0);
+    check(s.x >= 639 + 120 && s.x <= 641 + 120 && !has_msg(WM_KEYUP, 0x44), "the right half's stick looks while the left keeps walking",
+          "%d %s", s.x, dump());
+
+    /* One half going: the other keeps driving and keeps what it holds. */
+    s_n = 0;
+    rt_pad_test_detach(l);
+    padpump(&s, &d, 10);
+    check(has_msg(WM_KEYUP, 0x44) && !has_msg(WM_LBUTTONUP, 0) && s_n <= 2 && d.id == r && d.nslots == 1,
+          "the left half leaving lifts only its walk key, R2 stays held", "%s id %u", dump(), (unsigned)d.id);
+    s_n = 0;
+    l = rt_pad_test_attach(SENSE_L);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == r && d.nslots == 2, "the left half coming back joins with no switch", "%s", dump());
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTY, -32767);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_KEYDOWN, 0x57, 1), "the returned left half walks again", "%s", dump());
+    s_n = 0;
+    rt_pad_test_detach(r);
+    padpump(&s, &d, 10);
+    check(s_n == 1 && s_m[0].msg == WM_LBUTTONUP && d.id == l && d.gp, "the right half leaving lets go of R2 and hands the drive to the left",
+          "%s", dump());
+    s_n = 0;
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTY, 0);
+    padpump(&s, &d, 10);
+    rt_pad_test_detach(l);
+    padpump(&s, &d, 10);
+    check(!d.gp && d.nslots == 0, "both halves gone leaves no pad", "slots %d", d.nslots);
+
+    /* R, then L: the right half alone has no walk until the left comes. */
+    play_state(&s, &d);
+    r = rt_pad_test_attach(SENSE_R);
+    padpump(&s, &d, 10);
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 20000);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_LBUTTONDOWN, 1, 1) && d.id == r, "a lone right half fires", "%s", dump());
+    s_n = 0;
+    l = rt_pad_test_attach(SENSE_L);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == r && d.nslots == 2 && rt_pad_kind() == RT_PAD_PLAYSTATION,
+          "the left half joining a firing right half releases nothing", "%s", dump());
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, -32767);
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFT_TRIGGER, 20000);
+    padpump(&s, &d, 10);
+    check(s_n == 2 && has_msg(WM_KEYDOWN, 0x41) && has_msg(WM_RBUTTONDOWN, 0), "the late left half walks and takes L2", "%s", dump());
+
+    /* A pair arriving after its halves replaces them with no double
+       input: what both report held stays held, once. Buttons and sticks
+       only, since SDL reports a trigger held as a pad opens only once it
+       moves. */
+    s_n = 0;
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFT_TRIGGER, 0);
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+    rt_pad_test_button(r, SDL_GAMEPAD_BUTTON_SOUTH, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 3 && has_msg(WM_RBUTTONUP, 0) && has_msg(WM_LBUTTONUP, 0) && has_msg(WM_KEYDOWN, 0x20),
+          "the halves let go of both triggers and hold Cross", "%s", dump());
+    s_n = 0;
+    SDL_JoystickID lr = rt_pad_test_attach(SENSE_LR);
+    rt_pad_test_axis(lr, SDL_GAMEPAD_AXIS_LEFTX, -32767);
+    rt_pad_test_button(lr, SDL_GAMEPAD_BUTTON_SOUTH, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == lr && d.nslots == 1 && d.nignored == 2, "a pair after its halves takes over silently and closes them",
+          "%s id %u slots %d ignored %d", dump(), (unsigned)d.id, d.nslots, d.nignored);
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    rt_pad_test_button(r, SDL_GAMEPAD_BUTTON_SOUTH, 0);
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 20000);
+    for (int i = 0; i < 3; i++) padpump(&s, &d, 10);
+    check(s_n == 0 && d.nslots == 1, "the closed halves are ignored while the pair is open", "%s", dump());
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+    rt_pad_test_axis(lr, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    rt_pad_test_button(lr, SDL_GAMEPAD_BUTTON_SOUTH, 0);
+    padpump(&s, &d, 10);
+    check(s_n == 2 && has_msg(WM_KEYUP, 0x41) && has_msg(WM_KEYUP, 0x20), "the pair lets go of the walk key and Cross once", "%s", dump());
+
+    /* The pair going brings back the halves still connected. */
+    s_n = 0;
+    rt_pad_test_detach(lr);
+    padpump(&s, &d, 10);
+    check(d.nslots == 2 && d.gp && rt_pad_half(SDL_GetJoystickName(SDL_GetGamepadJoystick(d.gp))) != RT_PAD_WHOLE && d.nignored == 0,
+          "with the pair gone the halves drive again", "slots %d ignored %d", d.nslots, d.nignored);
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 32767);
+    padpump(&s, &d, 10);
+    check(has_msg(WM_KEYDOWN, 0x44), "the reopened left half walks", "%s", dump());
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    padpump(&s, &d, 10);
+
+    /* A pad already open when a pair arrives: only the halves give way. */
+    s_n = 0;
+    SDL_JoystickID ds = rt_pad_test_attach("DualSense Wireless Controller");
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.nslots == 3 && rt_pad_half(SDL_GetJoystickName(SDL_GetGamepadJoystick(d.gp))) != RT_PAD_WHOLE, "a DualSense connecting does not take the drive",
+          "%s slots %d", dump(), d.nslots);
+
+    /* A DualSense takes over from the pair of halves and hands back. */
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 20000);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_button(ds, SDL_GAMEPAD_BUTTON_EAST, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 2 && s_m[0].msg == WM_LBUTTONUP && s_m[1].msg == WM_KEYDOWN && s_m[1].wp == 0x45 && d.id == ds,
+          "a fresh DualSense press takes the drive from the halves and lifts their R2", "%s", dump());
+    s_n = 0;
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == ds, "a half letting go of a held trigger does not take the drive back", "%s", dump());
+    rt_pad_test_button(ds, SDL_GAMEPAD_BUTTON_EAST, 0);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 32767);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_KEYDOWN, 0x44, 1) && rt_pad_half(SDL_GetJoystickName(SDL_GetGamepadJoystick(d.gp))) == RT_PAD_HALF_L && rt_pad_kind() == RT_PAD_PLAYSTATION,
+          "a fresh push on the left half takes the drive back for both halves", "%s", dump());
+    s_n = 0;
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 20000);
+    padpump(&s, &d, 10);
+    check(msgs_are(WM_LBUTTONDOWN, 1, 1) && rt_pad_half(SDL_GetJoystickName(SDL_GetGamepadJoystick(d.gp))) == RT_PAD_HALF_L,
+          "the right half's press counts as the same pad and switches nothing", "%s", dump());
+
+    /* A pair arriving while the DualSense drives closes the halves and
+       leaves the drive where it is. */
+    rt_pad_test_axis(r, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0);
+    rt_pad_test_axis(l, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(ds, SDL_GAMEPAD_BUTTON_EAST, 1);
+    padpump(&s, &d, 10);
+    rt_pad_test_button(ds, SDL_GAMEPAD_BUTTON_EAST, 0);
+    padpump(&s, &d, 10);
+    s_n = 0;
+    rt_pad_test_detach(l);
+    rt_pad_test_detach(r);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == ds && d.nslots == 1, "halves leaving while a DualSense drives change nothing", "%s", dump());
+    l = rt_pad_test_attach(SENSE_L);
+    r = rt_pad_test_attach(SENSE_R);
+    padpump(&s, &d, 10);
+    lr = rt_pad_test_attach(SENSE_LR);
+    padpump(&s, &d, 10);
+    check(s_n == 0 && d.id == ds && d.nslots == 2 && pair_open(&d), "a pair while a DualSense drives replaces the halves, not the drive",
+          "%s slots %d", dump(), d.nslots);
+    rt_pad_test_button(lr, SDL_GAMEPAD_BUTTON_SOUTH, 1);
+    padpump(&s, &d, 10);
+    check(s_n == 1 && s_m[0].msg == WM_KEYDOWN && s_m[0].wp == 0x20 && d.id == lr, "a fresh press on the pair takes the drive", "%s", dump());
+    rt_pad_test_button(lr, SDL_GAMEPAD_BUTTON_SOUTH, 0);
+    padpump(&s, &d, 10);
+    rt_pad_test_detach(lr);
+    rt_pad_test_detach(l);
+    rt_pad_test_detach(r);
+    rt_pad_test_detach(ds);
+    padpump(&s, &d, 10);
+    check(!d.gp && d.nslots == 0, "everything gone leaves no pad", "slots %d", d.nslots);
+}
