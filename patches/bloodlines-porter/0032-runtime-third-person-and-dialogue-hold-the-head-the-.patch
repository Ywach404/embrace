+    check(near_deg(game[1], 70, 1e-3), "and the head turns it again from there", "yaw %.3f", game[1]);
+    check(h.holds == 1, "one hold counted", "%u", h.holds);
 
     rt_input_state s;
     memset(&s, 0, sizeof s);
