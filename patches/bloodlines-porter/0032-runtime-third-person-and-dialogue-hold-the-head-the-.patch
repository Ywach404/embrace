     rt_headlook_in in = {.host_on = 1, .head_yaw = 0, .head_pitch = 0, .play = 1, .have_angles = 1};
     float game[3] = {0, 30, 0};
     hl_step(&h, &in, game);
+    in.head_pitch = 10;
+    hl_step(&h, &in, game);
+    check(fabsf(game[0] + 10.0f) < 1e-3f && fabsf(h.pose_pitch - 10.0f) < 1e-3f,
+          "first person: the head looking up looks the view up (the game's pitch is down positive) and the frame records it up",
