 {
@@ -2476,11 +2498,65 @@ static void archive_dxvk_log(const char *dir)
     closedir(d);
 }
 
+static void metal_log(const char *msg) { rt_log("gfx metal %s", msg); }
+
+static void metal_stop(const char *msg) { rt_stop(10, 0, "gfx metal %s", msg); }
+
+/* The metal backend exports the same Direct3DCreate9 entry DXVK does and
+   implements the interfaces with the same vtable order and plain C ABI, so
+   the bridge's repacking, bounce locks and capture hooks are unchanged. The
+   one extra export hands it rt_log and rt_stop, so an unexpected method
+   stops the run through the runtime with its name. Nothing Vulkan is set up
+   or required here. */
+static int metal_init(const char *overlay)
+{
+    char exe[PATH_MAX], lib[PATH_MAX], path[PATH_MAX + 64];
+    own_exe(exe);
+    const char *e_lib = getenv("RT_METAL_D3D9_LIB");
+    char *slash = strrchr(exe, '/');
+    if (slash) *slash = 0;
+    size_t n = strlen(exe);
+    if (e_lib) snprintf(lib, sizeof lib, "%s", e_lib);
+    else if (n > 15 && !strcmp(exe + n - 15, "/Contents/MacOS"))
+        snprintf(lib, sizeof lib, "%.*s/Frameworks/libmetal_d3d9.dylib", (int)(n - 6), exe);
+    else snprintf(lib, sizeof lib, "%s/libmetal_d3d9.dylib", exe);
+    rt_log("gfx paths metal: lib %s", lib);
+    if (access(lib, R_OK)) {
+        rt_log("gfx missing %s; --gfx null runs without it", lib);
+        return -1;
+    }
+    snprintf(path, sizeof path, "%s/files/Vampire/vidcfg.bin", overlay);
+    FILE *f = fopen(path, "rb");
+    if (f) {
+        unsigned char id[16];
+        int zero = fread(id, 1, 16, f) == 16;
+        fclose(f);
+        for (int i = 0; i < 16 && zero; i++) zero = !id[i];
+        if (zero) rt_log("gfx deleted %s (null device ID): %s", path, unlink(path) ? "failed" : "ok");
+    }
+    s_lib = dlopen(lib, RTLD_NOW | RTLD_LOCAL);
+    if (!s_lib) {
+        rt_log("gfx missing %s: %s; --gfx null runs without it", lib, dlerror());
+        return -1;
+    }
+    s_create9 = (void *(*)(uint32_t))dlsym(s_lib, "Direct3DCreate9");
+    void (*host)(void (*)(const char *), void (*)(const char *)) =
+        (void (*)(void (*)(const char *), void (*)(const char *)))dlsym(s_lib, "metal_d3d9_set_host");
+    if (!s_create9 || !host) {
+        rt_log("gfx missing Direct3DCreate9 or metal_d3d9_set_host in %s; --gfx null runs without it", lib);
+        return -1;
+    }
+    host(metal_log, metal_stop);
+    rt_log("gfx metal %s", lib);
+    return 0;
+}
+
