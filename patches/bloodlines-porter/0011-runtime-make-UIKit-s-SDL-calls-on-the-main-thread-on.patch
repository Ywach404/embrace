@@ -437,11 +608,8 @@ static void window_tick(void)
 
 int rt_pump_due(void) { return s_sdl && rt_now_ns() - s_last_pump >= 16000000u; }
 
-void rt_pump(int force)
+static void pump(uint64_t now)
 {
-    (void)force;
-    if (!s_sdl || !rt_is_primary()) return;
-    uint64_t now = rt_now_ns();
     if (s_main_hwnd) rt_note_pump_gap(now - s_last_pump);
     s_last_pump = now;
     SDL_PumpEvents();
@@ -521,6 +689,28 @@ void rt_pump(int force)
     }
     rt_input_pump_end();
     window_tick();
+}
+
+#if TARGET_OS_VISION
+static void pump_hop(void *p) { pump(*(uint64_t *)p); }
+#endif
+
+/* On visionOS the whole pump is one hop: SDL's event pump, the input
+   script, every event's handling (which can warp the pointer, change
+   relative mode or read the view's size) and the full screen tick. The
+   game thread waits in the hop, so the runtime state those touch is not
+   shared with it meanwhile. The primary check stays here, where the
+   thread is the runtime's. */
+void rt_pump(int force)
+{
+    (void)force;
+    if (!s_sdl || !rt_is_primary()) return;
+    uint64_t now = rt_now_ns();
+#if TARGET_OS_VISION
+    rt_main_hop(pump_hop, &now);
+#else
+    pump(now);
+#endif
     s_pump_ns += rt_now_ns() - now;
 }
 
@@ -529,7 +719,20 @@ uint64_t rt_pump_ns(void) { return s_pump_ns; }
 int rt_window_wait_event(uint32_t ms)
 {
     if (!s_sdl) return 0;
+#if TARGET_OS_VISION
+    /* SDL_WaitEventTimeout pumps on the calling thread, and the main
+       thread cannot be held for the wait. UIKit's events reach SDL's queue
+       from the main run loop by themselves, so this only watches the queue
+       until one is there; the caller pumps, in a hop, when it returns. */
+    uint64_t end = rt_now_ns() + (uint64_t)ms * 1000000u;
+    for (;;) {
+        if (SDL_HasEvents(SDL_EVENT_FIRST, SDL_EVENT_LAST)) return 1;
+        if (rt_now_ns() >= end) return 0;
+        SDL_DelayNS(1000000u);
+    }
+#else
     return SDL_WaitEventTimeout(NULL, (Sint32)ms);
+#endif
 }
 
 void rt_window_push_close(void)
