+#if TARGET_OS_VISION
+/* The main window's size in pixels, w << 32 | h, or 0 when there is none.
+   Written on the main thread at the end of every hop, read by
+   rt_window_pixels on the runtime's thread. */
+static uint64_t s_px;
+
+static void px_note(void)
+{
+    rt_win *w = s_main_hwnd ? rt_win_get(s_main_hwnd) : NULL;
+    int pw = 0, ph = 0;
+    uint64_t v = 0;
+    if (w && w->sdl && SDL_GetWindowSizeInPixels(w->sdl, &pw, &ph) && pw > 0 && ph > 0)
+        v = (uint64_t)(uint32_t)pw << 32 | (uint32_t)ph;
+    __atomic_store_n(&s_px, v, __ATOMIC_RELEASE);
+}
+
+typedef struct {
+    void (*fn)(void *);
+    void *ctx;
+} hop;
+
+static void hop_run(void *p)
+{
+    hop *h = p;
+    h->fn(h->ctx);
+    px_note();
+}
+
+void rt_main_hop(void (*fn)(void *), void *ctx)
+{
+    hop h = {fn, ctx};
+    if (pthread_main_np()) hop_run(&h);
+    else dispatch_sync_f(dispatch_get_main_queue(), &h, hop_run);
+}
+
+static void main_ready(void *p)
+{
+    (void)p;
+    /* SDL on UIKit refuses SDL_Init until its main has been declared
+       ready, which SDL_main would do, and the first thread to declare it
+       becomes SDL's main thread. */
+    SDL_SetMainReady();
+}
+
+void rt_window_main_ready(void) { rt_main_hop(main_ready, NULL); }
+
+typedef struct {
+    void *sw;
+    int *w, *h;
+    int ok;
+} px_ask;
+
+static void px_hop(void *p)
+{
+    px_ask *a = p;
+    a->ok = SDL_GetWindowSizeInPixels(a->sw, a->w, a->h);
+}
+
+int rt_window_pixels(void *sw, int *w, int *h)
+{
+    *w = *h = 0;
+    if (!sw) return 0;
+    if (pthread_main_np()) return SDL_GetWindowSizeInPixels(sw, w, h);
+    /* The main window is only created, resized or destroyed in hops while
+       this thread waits, so reading the table here does not race them. */
+    rt_win *m = s_main_hwnd ? rt_win_get(s_main_hwnd) : NULL;
+    uint64_t v = __atomic_load_n(&s_px, __ATOMIC_ACQUIRE);
+    if (m && m->sdl == sw && v) {
+        *w = (int)(v >> 32);
+        *h = (int)(uint32_t)v;
+        return 1;
+    }
+    px_ask a = {sw, w, h, 0};
+    rt_main_hop(px_hop, &a);
+    return a.ok;
+}
+
+static void init_hop(void *p) { *(int *)p = video_init(); }
+#endif
+
+int rt_window_init(void)
+{
+    SDL_SetHint(SDL_HINT_VIDEO_MAC_FULLSCREEN_SPACES, "1");
+    SDL_SetHint(SDL_HINT_VIDEO_METAL_AUTO_RESIZE_DRAWABLE, "0");
+#if TARGET_OS_VISION
+    /* The host has made the main thread SDL's main thread already
+       (rt_host_start); video init records it as the video thread too. */
+    int r = -1;
+    rt_main_hop(init_hop, &r);
+    return r;
+#else
+    return video_init();
+#endif
+}
