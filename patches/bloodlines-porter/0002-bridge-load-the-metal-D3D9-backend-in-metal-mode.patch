 {
     int ww, wh;
@@ -975,10 +996,11 @@ static uint32_t d_createdevice(const uint32_t *a)
     h_adapter_id id;
     memset(&id, 0, sizeof id);
     VT(e->host, D_ADAPTERID, HR (*)(void *, uint32_t, uint32_t, h_adapter_id *))(e->host, a[1], 0, &id);
-    rt_stage(9, "dxvk \"%.*s\" vendor 0x%04X %ux%u windowed %d format %u flags 0x%X backbuffers %u interval 0x%X", 512,
-             id.Description, id.VendorId, pp.BackBufferWidth, pp.BackBufferHeight, pp.Windowed, pp.BackBufferFormat,
-             a[4], pp.BackBufferCount, pp.PresentationInterval);
-    image_check();
+    rt_stage(9, "%s \"%.*s\" vendor 0x%04X %ux%u windowed %d format %u flags 0x%X backbuffers %u interval 0x%X",
+             s_mode == RT_GFX_METAL ? "metal" : "dxvk", 512, id.Description, id.VendorId, pp.BackBufferWidth,
+             pp.BackBufferHeight, pp.Windowed, pp.BackBufferFormat, a[4], pp.BackBufferCount, pp.PresentationInterval);
+    if (s_mode == RT_GFX_METAL) metal_image_check();
+    else image_check();
     s_dev_window = dw ? dw->sdl : fw ? fw->sdl : NULL;
     s_dev_host = dev;
     pthread_mutex_lock(&s_pr_mu);
@@ -2343,12 +2365,12 @@ static void build(void)
 
 static uint32_t b_create9(const uint32_t *a)
 {
-    if (s_mode != RT_GFX_DXVK) return rt_d3d9_null_shims[0].fn(a);
+    if (s_mode == RT_GFX_NULL) return rt_d3d9_null_shims[0].fn(a);
     main_only("Direct3DCreate9");
     build();
     void *d = s_create9(a[0]);
