diff --git a/runtime/input_selftest.c b/runtime/input_selftest.c
index 0d5066b..c85355a 100644
--- a/runtime/input_selftest.c
+++ b/runtime/input_selftest.c
@@ -2848,6 +2848,63 @@ static void head_hold(void)
     check(rt_input_head_mode(&s) == RT_HEAD_NONE, "head look off by hand is off", "%d", rt_input_head_mode(&s));
 }
 
+/* An aim transform pointing at yaw and pitch (ARKit: yaw positive left
+   from -Z, pitch up), built as the backend's mtl_view_rotation builds a
+   head's, with a translation the angles must ignore. */
+static void aim_at(float yaw_deg, float pitch_deg, float m[16])
+{
+    const double rad = 0.017453292519943295;
+    double cy = cos(yaw_deg * rad), sy = sin(yaw_deg * rad), cp = cos(pitch_deg * rad), sp = sin(pitch_deg * rad);
+    float r[16] = {(float)cy, 0, (float)-sy, 0, (float)(sy * sp), (float)cp, (float)(cy * sp), 0,
+                   (float)(sy * cp), (float)-sp, (float)(cy * cp), 0, 0.2f, 1.1f, -0.4f, 1};
+    memcpy(m, r, sizeof r);
+}
+
+/* Hand aim's angles (headlook.c): the command stands for the head's pose,
+   and the hand's offset from it turns the command alone. */
+static void hand_aim(void)
+{
+    float aim[16], out[3];
+    const float cmd[3] = {5, 100, 0};
+    float y, p;
+    aim_at(37, -12, aim);
+    rt_headlook_yaw_pitch(aim, &y, &p);
+    check(fabsf(y - 37) < 1e-3f && fabsf(p + 12) < 1e-3f, "hand aim reads a hand's yaw and pitch as the head's are read",
+          "yaw %.4f pitch %.4f", y, p);
+
+    aim_at(20, -5, aim);
+    rt_headlook_hand_aim(cmd, 20, -5, aim, out);
+    check(fabsf(out[0] - 5) < 1e-3f && fabsf(out[1] - 100) < 1e-3f && out[2] == 0,
+          "a hand pointing where the head looks leaves the command's angles", "%.4f %.4f %.4f", out[0], out[1], out[2]);
+
+    aim_at(50, -5, aim);
+    rt_headlook_hand_aim(cmd, 20, -5, aim, out);
+    check(fabsf(out[1] - 130) < 1e-3f && fabsf(out[0] - 5) < 1e-3f, "a hand 30 degrees left of the head turns the command 30 left",
+          "pitch %.4f yaw %.4f", out[0], out[1]);
+
+    aim_at(20, 15, aim);
+    rt_headlook_hand_aim(cmd, 20, -5, aim, out);
+    check(fabsf(out[0] - (5 - 20)) < 1e-3f && fabsf(out[1] - 100) < 1e-3f,
+          "a hand 20 degrees above the head raises the command 20 (the game's pitch is down positive)", "pitch %.4f yaw %.4f",
+          out[0], out[1]);
+
+    const float low[3] = {80, 0, 0}, high[3] = {-80, 0, 0};
+    aim_at(0, -30, aim);
+    rt_headlook_hand_aim(low, 0, 0, aim, out);
+    float down = out[0];
+    aim_at(0, 30, aim);
+    rt_headlook_hand_aim(high, 0, 0, aim, out);
+    check(down == RT_HEADLOOK_PITCH_DOWN && out[0] == -RT_HEADLOOK_PITCH_UP, "hand aim clamps the pitch at the game's 89 degrees",
+          "down %.4f up %.4f", down, out[0]);
+
+    const float back[3] = {0, 170, 3};
+    aim_at(-150, 0, aim);
+    rt_headlook_hand_aim(back, 160, 0, aim, out);
+    check(fabsf(out[1] - (-140)) < 1e-3f && out[2] == 3,
+          "hand aim wraps the yaw through 180 (head 160, hand -150 is 50 left: 170 turns to -140) and keeps the roll",
+          "yaw %.4f roll %.4f", out[1], out[2]);
+}
+
 /* The right stick under head look: it turns the body, smoothly or in
    snaps, and sends no mouse look. */
 static void pad_turn(void)
@@ -2984,6 +3041,7 @@ int rt_input_selftest(void)
     head_hold();
     head_look_drift();
     head_look_write();
+    hand_aim();
