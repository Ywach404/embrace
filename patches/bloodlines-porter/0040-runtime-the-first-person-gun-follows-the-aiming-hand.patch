+/* The head's latest position, three floats too many for one word, so
+   under a sequence word as the hand slots are: odd while a write is under
+   way. The pump takes it when it takes the angles (s_head_pos), and hand
+   aim's view model reads that copy (rt_input_head_position). */
+static uint32_t s_head_pos_seq;
+static int s_head_pos_have;
+static float s_head_pos_host[3];
+static float s_head_pos[3];
+static int s_head_pos_valid;
+
+void rt_host_head_position(float x, float y, float z)
+{
+    __atomic_fetch_add(&s_head_pos_seq, 1, __ATOMIC_ACQ_REL);
+    s_head_pos_host[0] = x;
+    s_head_pos_host[1] = y;
+    s_head_pos_host[2] = z;
+    s_head_pos_have = 1;
+    __atomic_fetch_add(&s_head_pos_seq, 1, __ATOMIC_ACQ_REL);
+}
+
+static void head_position_take(void)
+{
+    for (int tries = 0; tries < 4; tries++) {
+        uint32_t a = __atomic_load_n(&s_head_pos_seq, __ATOMIC_ACQUIRE);
+        if (a & 1) continue;
+        float p[3];
+        int have = s_head_pos_have;
+        memcpy(p, s_head_pos_host, sizeof p);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&s_head_pos_seq, __ATOMIC_RELAXED) != a) continue;
+        memcpy(s_head_pos, p, sizeof p);
+        s_head_pos_valid = have;
+        return;
+    }
+}
