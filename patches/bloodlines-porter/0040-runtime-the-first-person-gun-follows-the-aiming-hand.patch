 static uint32_t hand_aim(const uint32_t *a)
 {
 #if TARGET_OS_VISION
@@ -104,15 +239,35 @@ static uint32_t hand_aim(const uint32_t *a)
 }
 
 static const rt_shim k_hand_aim = {"m9", "HandAim", 1, hand_aim, RT_SHIM_REAL};
+static const rt_shim k_hand_aim_view_model = {"m9", "HandAimViewModel", 7, hand_aim_view_model, RT_SHIM_REAL};
