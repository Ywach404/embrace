+/* A right stick push for one pump, then where it is left. */
+static void rstick(rt_input_state *s, rt_pad_dev *d, SDL_JoystickID id, int x, int y)
+{
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHTX, x);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_RIGHTY, y);
+    padpump(s, d, 10);
+}
+
+static void pad_dialogue(void)
+{
+    rt_input_state s;
+    rt_pad_dev d;
+    st(&s);
+    s.x = 640;
+    s.y = 512;
+    s.cursor = 0;
+    rt_input_relative_update(&s);
+    rt_pad_dev_init(&d, NULL);
+    SDL_JoystickID id = rt_pad_test_attach("PlayStation VR2 Sense Controllers (L/R)");
+    padpump(&s, &d, 10);
+    check(d.pad.mode == RT_PAD_PLAY && s_n == 0, "no dialogue and a hidden cursor is play", "mode %d %s", d.pad.mode, dump());
+
+    /* Entry from the probe's flag; a stick already looking, and the left
+       stick walking, as the dialogue opens. */
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTY, -32767);
+    rstick(&s, &d, id, 0, -32767);
+    s_n = 0;
+    s.dialogue = 1;
+    padpump(&s, &d, 10);
+    check(rt_input_pad_mode(&s) == RT_PAD_DIALOGUE && d.pad.mode == RT_PAD_DIALOGUE, "the dialogue flag enters dialogue mode", "mode %d",
+          d.pad.mode);
+    /* The last look's move is flushed ahead of the key. */
+    int k1 = s_n == 2 && s_m[0].msg == WM_MOUSEMOVE;
+    check((s_n == 1 || k1) && s_m[k1].msg == WM_KEYUP && s_m[k1].wp == 0x57,
+          "entering a dialogue lifts the walk key and picks nothing for a stick already pushed", "%s", dump());
+    s_n = 0;
+    int32_t lx = s.x, ly = s.y;
+    for (int i = 0; i < 5; i++) padpump(&s, &d, 10);
+    check(s_n == 0 && s.x == lx && s.y == ly, "a stick held since before the dialogue never picks, and neither stick looks or walks",
+          "%s at %d,%d", dump(), s.x, s.y);
+    rt_pad_test_axis(id, SDL_GAMEPAD_AXIS_LEFTY, 0);
+    rstick(&s, &d, id, 0, 0);
+    check(s_n == 0, "centring the stick sends nothing", "%s", dump());
+
+    /* Each flick is its number key, laid out as the d-pad, once per push:
+       held for half a second it neither repeats nor moves anything. */
+    static const struct {
+        int x, y;
+        uint32_t vk;
+        const char *name;
+    } k_flick[] = {{0, -32767, 0x31, "up is 1"},     {32767, 0, 0x32, "right is 2"}, {0, 32767, 0x33, "down is 3"},
+                   {-32767, 0, 0x34, "left is 4"},   {9000, -30000, 0x31, "a diagonal goes to the axis further out (1)"},
+                   {20000, -30000, 0x31, "a diagonal past half tilt on both axes still goes to the further (1)"},
+                   {-30000, 20000, 0x34, "a diagonal goes to the axis further out (4)"}};
+    char name[96];
+    for (size_t i = 0; i < sizeof k_flick / sizeof *k_flick; i++) {
+        s_n = 0;
+        rstick(&s, &d, id, k_flick[i].x, k_flick[i].y);
+        snprintf(name, sizeof name, "dialogue flick %s", k_flick[i].name);
+        check(s_n >= 1 && s_n <= 2 && s_m[0].msg == WM_KEYDOWN && s_m[0].wp == k_flick[i].vk, name, "%s", dump());
+        s_n = 0;
+        for (int f = 0; f < 50; f++) padpump(&s, &d, 10);
+        snprintf(name, sizeof name, "dialogue flick %s, held, does not repeat", k_flick[i].name);
+        check(s_n == 0, name, "%s", dump());
+        rstick(&s, &d, id, 0, 0);
+        snprintf(name, sizeof name, "dialogue flick %s, released, lifts the key the game picks on", k_flick[i].name);
