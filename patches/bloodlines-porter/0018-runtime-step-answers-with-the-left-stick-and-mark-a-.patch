 }
 
+/* One answer is what "continue" is in this HUD, so it is marked as soon
+   as it shows and Cross confirms it with no step first. It is checked
+   every pump, so a pick that leads to a one-answer node is marked too;
+   a Cross that soon after a pick still waits out the guard in sel_act.
+   Two sets are left alone: the one Circle cleared, which the player
+   chose not to have marked, and the one a confirm just picked, which is
+   still on screen until the game moves on and must not be marked again
+   and copied into the history with its marker. Only while a pad drives
+   a dialogue: a keyboard player sees the game's own text. */
+static void sel_auto(rt_dialogue_sel *g, uint32_t va, uint64_t now, int can_auto)
+{
+    if (!va || !panel8(va + DIALOGUE_ACTIVE)) g->skip_on = g->await_on = 0;
+    if (g->lit || !sel_ready(va)) return;
+    int32_t count = (int32_t)panel32(va + DIALOGUE_COUNT);
+    uint32_t key = set_key(va, count);
+    if (g->skip_on && key != g->skip_key) g->skip_on = 0;
+    if (g->await_on && (key != g->await_key || g->pick_bits != g->await_bits)) g->await_on = 0;
+    if (count != 1 || g->skip_on || g->await_on || !can_auto) return;
+    sel_light(g, va, 1, 0, now);
+    g->autos++;
+    rt_log("dialogue lone answer marked");
+}
+
+/* Once per pump, before the pad is read, on the game thread: the pump
+   runs between the game's frames, so nothing of the game's writes a slot
+   while it is read or edited here. */
+static void sel_sync(rt_input_state *s, uint64_t now, int can_auto)
+{
+    rt_dialogue_sel *g = &s->sel;
+    uint32_t va = s->dialogue_va;
+    if (va) {
+        uint32_t bits = panel32(va + DIALOGUE_PICK_TIME);
+        if (g->pick_va == va && bits != g->pick_bits) g->pick_ns = now;
+        g->pick_va = va;
+        g->pick_bits = bits;
+    }
+    if (g->lit) sel_check(g, va, now);
+    sel_auto(g, va, now, can_auto);
+}
