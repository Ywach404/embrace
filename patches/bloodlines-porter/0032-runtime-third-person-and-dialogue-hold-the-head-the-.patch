+
+    /* Into third person: nothing written, the reference fixed. */
+    in.hold = 1;
+    float before[3] = {game[0], game[1], game[2]};
+    w = hl_step(&h, &in, game);
+    check(!w && game[0] == before[0] && game[1] == before[1], "held: the head writes nothing", "w %d pitch %.3f yaw %.3f", w,
+          game[0], game[1]);
+    check(h.pose_valid && h.pose_yaw == 40 && fabsf(h.pose_pitch + 20.0f) < 1e-3f,
+          "held: the frame is drawn for the head's facing and the game's pitch when the hold began", "pose %d %.3f %.3f",
+          h.pose_valid, h.pose_yaw, h.pose_pitch);
     in.head_yaw = -20;
-    in.head_pitch = -15;
-    hl_step(&h, &in, game);
-    check(near_deg(game[1], 70, 1e-3) && fabsf(game[0] - 15.0f) < 1e-3f, "third person: head yaw does nothing, head pitch tilts the camera",
-          "pitch %.3f yaw %.3f", game[0], game[1]);
-    check(h.pose_valid && h.pose_yaw == 40, "third person: the frame is drawn for the reference, so the world holds still",
-          "pose %d %.3f", h.pose_valid, h.pose_yaw);
-    in.turn = 10;
-    hl_step(&h, &in, game);
-    check(near_deg(game[1], 80, 1e-3), "third person: the stick turns the body", "yaw %.3f", game[1]);
+    in.head_pitch = 30;
+    w = hl_step(&h, &in, game);
+    check(!w && game[0] == before[0] && game[1] == before[1] && h.pose_yaw == 40 && fabsf(h.pose_pitch + 20.0f) < 1e-3f,
+          "held: head yaw and pitch move nothing, and the reference stays put", "w %d pose %.3f %.3f", w, h.pose_yaw,
