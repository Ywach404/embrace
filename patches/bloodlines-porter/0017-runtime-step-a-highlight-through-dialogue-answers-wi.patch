        guest's own flag, or directly by the self test. */
     int dialogue;
+    /* The HUD's guest address once its vtable checks out, active or not;
+       0 when there is none. The answer highlight reads and edits it. */
+    uint32_t dialogue_va;
+    rt_dialogue_sel sel;
     uint32_t cursor;
     int show_count;
     int applied;
