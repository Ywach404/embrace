+        rt_dsound_focus(1);
+        rt_input_post(mw->hwnd, 0x001C, 1, 0);
+        rt_input_post(mw->hwnd, 0x0006, 1, 0);
+    }
+#endif
     rt_input_script_step();
     SDL_Event e;
     while (SDL_PollEvent(&e)) {
@@ -663,6 +675,14 @@ static void pump(uint64_t now)
         case SDL_EVENT_WINDOW_FOCUS_LOST:
             if (w) {
                 int on = e.type == SDL_EVENT_WINDOW_FOCUS_GAINED;
+#if TARGET_OS_VISION
+                /* In an immersive space the game's window never has focus;
+                   the host holds it for the game. */
+                if (!on && w->hwnd == s_main_hwnd && rt_input_host_claimed()) {
+                    rt_log("window focus loss ignored, host holds input");
+                    break;
+                }
+#endif
                 if (w->hwnd == s_main_hwnd) {
                     rt_input_focus(on);
                     rt_dsound_focus(on);
