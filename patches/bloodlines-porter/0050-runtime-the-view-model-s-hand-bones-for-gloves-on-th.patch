From 3c327c2e7374e79d27c6be6f04b65beb9014fd8e Mon Sep 17 00:00:00 2001
From: "A.Cervantez" <155030226+Ywach404@users.noreply.github.com>
Date: Tue, 24 Nov 2026 19:53:48 -0600
Subject: [PATCH] runtime: the view model's hand bones for gloves on the game's
 hands

The first person view model keeps the bone to world matrices its last SetupBones made. Reading the view model list, its studio header's bone names and that cache (client +0x4A0D64, +0x6AC, +0x728) after the frame is drawn gives the game's hands as its animations posed them, after the hand aim shim moved the model. RT_VM_BONES=1 logs the bones; RT_HANDS_ATTACH=1 hands them to the renderer. Nothing is called; these are reads.
---
 runtime/input.c              |   2 +
 runtime/input_selftest.c     |  19 +++
 runtime/rt.h                 |   8 +
 runtime/sources.txt          |   1 +
 runtime/sources_visionos.txt |   1 +
 runtime/vmbones.c            | 287 +++++++++++++++++++++++++++++++++++
 6 files changed, 318 insertions(+)
 create mode 100644 runtime/vmbones.c

diff --git a/runtime/input.c b/runtime/input.c
index 34aa7d9..9fd445c 100644
--- a/runtime/input.c
+++ b/runtime/input.c
@@ -1768,6 +1768,7 @@ int rt_host_aim_ray(float eye[3], float dir[3], float cam[3], float cam_ang[3])
    frame's: read at the pump, it would be the frame before's. */
 void metal_d3d9_fullview_aim_source(int (*fn)(float eye[3], float dir[3]));
 void metal_d3d9_fullview_aim_trace_source(int (*fn)(float *t, int *hit));
+void metal_d3d9_fullview_hands_source(int (*fn)(float pts[18]));
 /* Which ray the shot is traced along. The eye along the engine's view
    angles is the game's: the depth search on it sat on the game's mark in
    most of A.'s checks. The camera's own forward (CInput +0x164 off the
@@ -2086,6 +2087,7 @@ void rt_input_pump_end(void)
         aim_registered = 1;
         metal_d3d9_fullview_aim_source(aim_for_renderer);
         metal_d3d9_fullview_aim_trace_source(aim_trace_for_renderer);
+        if (rt_vm_bones_wanted()) metal_d3d9_fullview_hands_source(rt_vm_hands);
     }
 #endif
     if (s_pad_started) pad_pump();
diff --git a/runtime/input_selftest.c b/runtime/input_selftest.c
index 64402e7..7ab0f9f 100644
--- a/runtime/input_selftest.c
+++ b/runtime/input_selftest.c
@@ -3038,6 +3038,24 @@ static void hang_background(void)
     check(rt_hang_blocked_ms(30 * S, 0, 0, 0) == 0, "hang_background", "no call in progress counts nothing");
 }
 
+/* The view model's hand bones are found by name: the usual rigs' right
+   and left hands, and nothing that is a finger, an arm or sideless. */
+static void vm_bone_names(void)
+{
+    static const struct {
+        const char *name;
+        int want;
+    } k[] = {
+        {"Bip01 R Hand", 1},            {"Bip01 L Hand", 2},     {"ValveBiped.Bip01_R_Hand", 1},
+        {"ValveBiped.Bip01_L_Hand", 2}, {"R_Hand", 1},           {"left hand", 2},
+        {"RightHand", 0},               {"Bip01 R Finger0", 0},  {"Bip01 R Forearm", 0},
+        {"Bip01 Head", 0},              {"hand", 0},             {"Bip01 R Finger01 hand", 0},
+    };
+    for (size_t i = 0; i < sizeof k / sizeof k[0]; i++)
+        check(rt_vm_bone_hand(k[i].name) == k[i].want, "view model bone names", "\"%s\" gives %d, want %d", k[i].name,
+              rt_vm_bone_hand(k[i].name), k[i].want);
+}
+
 int rt_input_selftest(void)
 {
     setvbuf(stdout, NULL, _IOLBF, 0);
@@ -3082,6 +3100,7 @@ int rt_input_selftest(void)
     hand_place();
     pad_turn();
     pad_recentre();
+    vm_bone_names();
     printf("input selftest: %d PASS, %d FAIL\n", s_pass, s_fail);
     return s_fail ? 1 : 0;
 }
diff --git a/runtime/rt.h b/runtime/rt.h
index c6ba796..930c9c3 100644
--- a/runtime/rt.h
+++ b/runtime/rt.h
@@ -491,5 +491,13 @@ void rt_aspect_engine_init(int w, int h);
 void rt_aspect_engine_set(int w, int h, int on);
 void rt_hand_aim_init(void);
 uint32_t rt_hand_aim_commands(void);
+/* The first person view model's hand bones (vmbones.c): per hand, right
+   then left, its origin and points 4 units along its x and y axes, game
+   world units. Bit 0 right found, bit 1 left. 0 when off (RT_VM_BONES,
+   RT_HANDS_ATTACH) or none. */
+int rt_vm_bones_wanted(void);
+int rt_vm_hands(float pts[18]);
+/* A bone name's hand: 1 right, 2 left, 0 not a hand bone. */
+int rt_vm_bone_hand(const char *name);
 
 #endif
